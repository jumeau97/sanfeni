{% extends 'base.html.twig' %}

{% block title %}Mes commandes{% endblock %}

{% block stylesheets %}
    {% include 'account/_account_styles.html.twig' %}
    <style>
        /* Page /account/mes-commandes — liste de commandes. */

        .account-page .acc-orders {
            display: flex;
            flex-direction: column;
            gap: 1.6rem;
        }

        .account-page .acc-order {
            display: grid;
            grid-template-columns: 1.4fr 0.9fr 1.3fr 1.2fr auto;
            align-items: center;
            gap: 1.6rem;
            padding: 2rem 2.4rem;
            transition: border-color .2s ease, box-shadow .2s ease;
        }

        .account-page .acc-order:hover {
            border-color: rgba(8, 44, 106, .35);
            box-shadow: 0 8px 20px rgba(8, 44, 106, .06);
        }

        .account-page .acc-order__cell + .acc-order__cell {
            border-left: 1px solid var(--acc-line);
            padding-left: 1.6rem;
        }

        .account-page .acc-order__value {
            display: block;
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--acc-title);
            line-height: 1.3;
        }

        .account-page .acc-order__value small {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--acc-text);
        }

        .account-page .acc-order__ref {
            display: block;
            margin-top: 0.4rem;
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--acc-primary);
        }

        .account-page .acc-order__action {
            justify-self: end;
        }

        /* Tablette : deux colonnes, séparations verticales retirées,
           bouton pleine largeur. */
        @media (max-width: 992px) {
            .account-page .acc-order {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                row-gap: 2rem;
            }

            .account-page .acc-order__cell + .acc-order__cell {
                border-left: none;
                padding-left: 0;
            }

            .account-page .acc-order__action {
                grid-column: 1 / -1;
                justify-self: stretch;
            }

            .account-page .acc-order__action .acc-btn {
                width: 100%;
            }
        }

        /* Mobile : une seule colonne. */
        @media (max-width: 576px) {
            .account-page .acc-order {
                grid-template-columns: 1fr;
                padding: 1.8rem;
                row-gap: 1.6rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <section class="user-profile account-page">
        <div class="container">

            <header class="account-head">
                <div>
                    <h1>Mes commandes</h1>
                    <a href="{{ path('app_account') }}" class="account-back">
                        <i class="fas fa-arrow-left"></i> Retourner à mon compte
                    </a>
                </div>
            </header>

            {% if orders|length == 0 %}
                <div class="acc-empty">
                    <i class="fas fa-shopping-bag"></i>
                    <p>Vous n'avez pas encore passé de commande.</p>
                    <a href="{{ path('app_home') }}" class="acc-btn acc-btn--primary">
                        Commencer mes achats
                    </a>
                </div>
            {% else %}
                <div class="acc-orders">
                    {% for order in orders %}
                        {% set badge = 'acc-badge' %}
                        {% if order.state in ['Livrée', 'Validée'] %}
                            {% set badge = badge ~ ' acc-badge--success' %}
                        {% elseif order.state in ['Refusée', 'Partiellement refusée'] %}
                            {% set badge = badge ~ ' acc-badge--danger' %}
                        {% elseif order.state == 'En attente' %}
                            {% set badge = badge ~ ' acc-badge--accent' %}
                        {% endif %}
                        <article class="acc-card acc-order">
                            <div class="acc-order__cell">
                                <span class="acc-label">Commande du</span>
                                <span class="acc-order__value">{{ order.createdAt|date('d/m/Y') }}</span>
                                <span class="acc-order__ref">Réf : {{ order.reference }}</span>
                            </div>

                            <div class="acc-order__cell">
                                <span class="acc-label">Articles</span>
                                <span class="acc-order__value">{{ order.orderDetails|length }}</span>
                            </div>

                            <div class="acc-order__cell">
                                <span class="acc-label">Montant total</span>
                                <span class="acc-order__value">
                                    {{ (order.carrierPrice + order.getTotal)|number_format(0,',','.') }}
                                    <small>F CFA</small>
                                </span>
                            </div>

                            <div class="acc-order__cell">
                                <span class="acc-label">Statut</span>
                                <span class="{{ badge }}">{{ order.state }}</span>
                            </div>

                            <div class="acc-order__cell acc-order__action">
                                <a href="{{ path('account_order_show', {'reference': order.reference}) }}"
                                   class="acc-btn acc-btn--outline">
                                    Détails <i class="fas fa-chevron-right"></i>
                                </a>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}

        </div>
    </section>
{% endblock %}
