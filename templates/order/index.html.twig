{% extends 'base.html.twig' %}

{% block title %}Validation - Panier{% endblock %}

{% block stylesheets %}
    {% include 'order/_checkout_styles.html.twig' %}
{% endblock %}

{% block body %}
    <!--------------- checkout-section---------------->
    <section class="checkout-page wb-checkout">
        <div class="container">
            <header class="wb-checkout-head">
                <h1 class="wb-checkout-title">Finaliser ma commande</h1>
                <p class="wb-checkout-sub">Adresse, transporteur, puis paiement sécurisé.</p>
            </header>

            {{ form_start(form,{action:path('app_order_recap'), 'attr': { 'data-turbo': 'false' }}) }}
            <div class="row g-4">

                <div class="col-lg-7">
                    {# ---------------- Étape 1 : adresse ---------------- #}
                    <div class="wb-panel mb-4">
                        <div class="wb-panel-head">
                            <span class="wb-badge">1</span>
                            <h5 class="wb-panel-title">Adresse de livraison</h5>
                            <span class="wb-badge wb-badge--ico"><i class="fas fa-map-marker-alt"></i></span>
                        </div>
                        <div class="wb-panel-body">
                            <div class="wb-toolbar">
                                <span class="wb-eyebrow">Sélectionnez une adresse</span>
                                <a href="{{ path('app_account_address') }}" class="wb-link">
                                    <i class="fas fa-plus"></i> Ajouter
                                </a>
                            </div>
                            <div class="custom-form-radio">
                                {{ form_widget(form.adresses) |replace({'[br]': "<br>"})|raw }}
                            </div>
                        </div>
                    </div>

                    {# ---------------- Étape 2 : transporteur ---------------- #}
                    <div class="wb-panel">
                        <div class="wb-panel-head">
                            <span class="wb-badge">2</span>
                            <h5 class="wb-panel-title">Mode de livraison</h5>
                            <span class="wb-badge wb-badge--ico"><i class="fas fa-truck"></i></span>
                        </div>
                        <div class="wb-panel-body">
                            <div class="custom-form-radio">
                                {{ form_widget(form.carriers) |replace({'[br]': "<br>"})|raw }}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="sticky-top wb-sticky-aside">
                        <div class="wb-panel">
                            <div class="wb-panel-head">
                                <span class="wb-badge wb-badge--ico"><i class="fas fa-shopping-cart"></i></span>
                                <h4 class="wb-panel-title">Votre panier</h4>
                                <span class="wb-chip">
                                    {{ cart|length }} article{{ cart|length > 1 ? 's' : '' }}
                                </span>
                            </div>
                            <div class="wb-panel-body">

                                <ul class="wb-recap-list">
                                    {% set total = 0 %}
                                    {% for product in cart %}
                                        <li class="wb-recap-row">
                                            <div class="wb-recap-info">
                                                <span class="wb-recap-name">{{ product.product.name }}</span>
                                                <span class="wb-recap-qty">Qté : {{ product.quantity }}</span>
                                            </div>
                                            {% if product.product.isPromotion %}
                                                {% set itemPrice = ((product.product.price) * (1 - (product.product.offPercent / 100))) * product.quantity %}
                                            {% else %}
                                                {% set itemPrice = (product.product.price * product.quantity) %}
                                            {% endif %}
                                            <span class="wb-recap-price">{{ itemPrice | format_currency('XOF') }}</span>
                                        </li>
                                        {% set total = total + itemPrice %}
                                    {% endfor %}
                                </ul>

                                {# .wb-actionbar : sur mobile, ce bloc (total +
                                   bouton) devient la barre fixe en bas d'écran. #}
                                <div class="wb-actionbar">
                                    <div class="wb-total wb-actionbar__total">
                                        <span class="wb-total__label">Total final</span>
                                        <strong class="wb-total__value">{{ total | format_currency('XOF') }}</strong>
                                    </div>

                                    <button type="submit" class="wb-cta wb-actionbar__btn">
                                        Valider et payer <i class="fas fa-arrow-right"></i>
                                    </button>
                                </div>

                                <p class="wb-note">
                                    <i class="fas fa-shield-alt"></i> Paiement sécurisé — vos données restent privées.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            {{ form_end(form) }}
        </div>
    </section>
    <!--------------- checkout-section-end---------------->
{% endblock %}
