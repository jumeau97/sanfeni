{# Messages flash — inclus automatiquement par base_admin.html.twig #}
{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="admin-flash admin-flash-{{ type }}" role="alert">
            <i class="fas {{ type == 'success' ? 'fa-check-circle' : (type == 'error' ? 'fa-times-circle' : (type == 'warning' ? 'fa-exclamation-triangle' : 'fa-info-circle')) }} mt-1"></i>
            <span>{{ message }}</span>
        </div>
    {% endfor %}
{% endfor %}
