{# Racine LiveComponent : 'attributes' doit englober toute la zone
   rafraîchie (tableau + récapitulatif) pour que le rechargement
   émettant 'cartUpdated' mette tout à jour d'un coup. #}
<div {{ attributes }}>

    {% if cartItems is not empty %}
        <div class="wb-cart-grid">

            <section class="wb-cart-panel">
                <table class="wb-cart-table">
                    <thead>
                    <tr>
                        <th scope="col">Produit</th>
                        <th scope="col" class="wb-cart-th--qty">Quantité</th>
                        <th scope="col" class="wb-cart-th--total">Total</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for cartItem in cartItems %}
                        {{ component('CartItemRowComponent', {
                            productId: cartItem.product.id,
                            quantity: cartItem.quantity,
                            key: cartItem.product.id,
                        }) }}
                    {% endfor %}
                    </tbody>
                </table>
            </section>

            <aside class="wb-cart-summary">
                <h2 class="wb-cart-summary-title">Récapitulatif</h2>

                <dl class="wb-cart-summary-rows">
                    <div class="wb-cart-summary-row">
                        <dt>
                            Sous-total
                            ({{ cartItems|length }} article{{ cartItems|length > 1 ? 's' : '' }})
                        </dt>
                        <dd>{{ this.grandTotal|format_currency('XOF') }}</dd>
                    </div>
                    <div class="wb-cart-summary-row wb-cart-summary-row--hint">
                        <dt>Livraison</dt>
                        <dd>Calculée à l'étape suivante</dd>
                    </div>
                </dl>

                <div class="wb-cart-summary-total">
                    <span>Total</span>
                    <strong id="grand-total-amount">{{ this.grandTotal|format_currency('XOF') }}</strong>
                </div>

                <a href="{{ path('app_order') }}" class="wb-cart-cta">
                    Passer la commande <i class="fas fa-arrow-right"></i>
                </a>

                <a href="{{ path('app_home') }}" class="wb-cart-continue">
                    Continuer mes achats
                </a>
            </aside>

        </div>

        {# ----------------------------------------------------------
           Barre d'action fixe en bas d'écran (mobile uniquement,
           voir le bloc @media de cart/index.html.twig).

           Elle vit DANS le composant Live : à chaque rafraîchissement
           du panier, this.grandTotal est re-rendu ici aussi, donc le
           total affiché en bas ne peut pas se désynchroniser de celui
           du récapitulatif.
           ---------------------------------------------------------- #}
        <div class="wb-actionbar">
            <span class="wb-actionbar__total">
                <span class="wb-actionbar__label">Total</span>
                <strong class="wb-actionbar__value">{{ this.grandTotal|format_currency('XOF') }}</strong>
            </span>

            <a href="{{ path('app_order') }}" class="wb-actionbar__btn">
                Passer la commande <i class="fas fa-arrow-right"></i>
            </a>
        </div>

    {% else %}
        {# Panier vide #}
        <div class="wb-cart-empty">
            <div class="wb-cart-empty-icon">
                <i class="fas fa-shopping-cart"></i>
            </div>
            <h2>Votre panier est vide</h2>
            <p>Découvrez nos nouveautés et trouvez votre coup de cœur.</p>
            <a href="{{ path('app_home') }}" class="wb-cart-cta">
                Continuer mes achats <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    {% endif %}

</div>
