{#
    Styles partagés des pages d'authentification — Connexion / Inscription.
    Inclus par : templates/security/login.html.twig
                 templates/register/signup.html.twig

    Convention de taille du projet (public/css/style.css) :
        html { font-size: 10px }  →  1rem = 10px (et non 16px)
    Les utilitaires Bootstrap (.fs-*, .small, .py-*, .mb-*) sont donc
    rendus à 62,5 % de leur valeur nominale : ils sont évités ici et
    chaque échelle typographique est explicite, exprimée en rem.

    Police : Inter — famille unique du site, déjà chargée par
    public/css/style.css (@import) et base.html.twig.
#}
<style>
    /* ============================================================= *
     *  Palette locale                                               *
     *  --auth-navy   : liens et texte d'action (couleur « structure »
     *                  du site, #082C6A)                            *
     *  --auth-accent : bouton principal (orange de marque)          *
     * ============================================================= */
    .auth-page {
        --auth-ink: #1b1d21;
        --auth-muted: #6f767e;
        --auth-line: #e4e7ec;
        --auth-navy: #082c6a;
        --auth-navy-hover: #0b2f74;
        --auth-accent: #ffa500;
        --auth-accent-hover: #eea41e;
        --auth-danger: #dc3545;
        --auth-radius: 1.6rem;

        font-family: "Inter", -apple-system, "Segoe UI", Roboto,
                     "Helvetica Neue", Arial, sans-serif;
        color: var(--auth-ink);
        background: #f8f8f8;
        padding-block: clamp(2.4rem, 5vw, 5.6rem);
        -webkit-text-size-adjust: 100%;
    }

    /* ---------- Carte ---------- */
    .auth-page .auth-card {
        background: #fff;
        border: 1px solid var(--auth-line);
        border-radius: 2rem;
        box-shadow: 0 1.2rem 3rem rgba(8, 44, 106, .07);
        padding: clamp(2.4rem, 5vw, 4rem);
    }

    /* ---------- En-tête ---------- */
    .auth-page .auth-head {
        margin-bottom: clamp(2.4rem, 4vw, 3.2rem);
        text-align: center;
    }

    .auth-page .auth-title {
        margin: 0 0 .8rem;
        font-size: clamp(2.4rem, 2.1rem + .9vw, 3rem);
        font-weight: 800;
        letter-spacing: -.02em;
        line-height: 1.2;
        color: var(--auth-ink);
    }

    .auth-page .auth-sub {
        margin: 0;
        font-size: 1.5rem;
        line-height: 1.5;
        color: var(--auth-muted);
    }

    /* ---------- Formulaire ---------- */
    .auth-page .auth-form {
        display: grid;
        gap: 2rem;
    }

    .auth-page .auth-fields {
        display: grid;
        gap: 1.6rem;
    }

    /* Un champ = le champ flottant + son éventuel message d'erreur. */
    .auth-page .auth-field {
        display: grid;
        gap: .6rem;
    }

    /* Prénom / Nom côte à côte, empilés sous 576px. */
    .auth-page .auth-fields__pair {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.6rem;
    }

    /* ---------- Champs flottants ---------- */
    .auth-page .form-floating {
        position: relative;
        margin: 0;
    }

    .auth-page .form-floating > .form-control {
        height: 6.2rem;
        min-height: 6.2rem;
        padding: 3rem 1.8rem 1rem;
        font-size: 1.6rem; /* 16px : évite le zoom automatique d'iOS */
        font-weight: 450;
        line-height: 1.4;
        color: var(--auth-ink);
        background: #fff;
        border: 1.5px solid var(--auth-line);
        border-radius: var(--auth-radius);
        transition: border-color .18s ease, box-shadow .18s ease;
    }

    /* La place laissée en haut est réservée au label remonté. */
    .auth-page .form-floating > .form-control:focus,
    .auth-page .form-floating > .form-control:not(:placeholder-shown),
    .auth-page .form-floating > .form-control:-webkit-autofill {
        padding-top: 3rem;
        padding-bottom: 1rem;
    }

    .auth-page .form-floating > .form-control:focus {
        border-color: var(--auth-accent);
        box-shadow: 0 0 0 .4rem rgba(255, 165, 0, .16);
    }

    /* Au repos : label centré verticalement, aligné sur le texte saisi. */
    .auth-page .form-floating > label {
        display: block;
        padding: 2rem 1.8rem;
        font-size: 1.5rem;
        font-weight: 450;
        line-height: 1.4;
        color: var(--auth-muted);
        transform: none;
        transition: transform .15s ease, font-size .15s ease;
    }

    /* Focus / valeur saisie : le label remonte dans la zone réservée
       en haut du champ (padding conservé, seule la taille change). */
    .auth-page .form-floating > .form-control:focus ~ label,
    .auth-page .form-floating > .form-control:not(:placeholder-shown) ~ label,
    .auth-page .form-floating > .form-control:-webkit-autofill ~ label {
        font-size: 1.3rem;
        font-weight: 500;
        transform: translateY(-1.2rem);
    }

    /* Le cache en pseudo-élément de Bootstrap n'est pas nécessaire :
       le label reste à l'intérieur du champ et ne masque rien. */
    .auth-page .form-floating > .form-control:focus ~ label::after,
    .auth-page .form-floating > .form-control:not(:placeholder-shown) ~ label::after {
        content: none;
    }

    /* ---------- Champ invalide ----------
       Le thème ajoute automatiquement .is-invalid ; on garde la bordure
       rouge sans l'icône de Bootstrap (qui chevaucherait le label). */
    .auth-page .form-floating > .form-control.is-invalid {
        border-color: var(--auth-danger);
        background-image: none;
    }

    .auth-page .form-floating > .form-control.is-invalid:focus {
        border-color: var(--auth-danger);
        box-shadow: 0 0 0 .4rem rgba(220, 53, 69, .15);
    }

    /* ---------- Messages d'erreur (thème bootstrap_5_layout) ---------- */
    .auth-page .invalid-feedback {
        display: block;
        color: var(--auth-danger);
        font-size: 1.35rem;
        font-weight: 500;
        line-height: 1.45;
        margin: 0;
        padding-left: .4rem;
    }

    /* ---------- Bandeau d'erreur de connexion ---------- */
    .auth-page .auth-alert {
        background: #fdecec;
        border-left: .4rem solid var(--auth-danger);
        border-radius: 1rem;
        color: #b42318;
        font-size: 1.45rem;
        font-weight: 500;
        line-height: 1.5;
        margin: 0 0 2rem;
        padding: 1.4rem 1.6rem;
    }

    /* ---------- Ligne d'options (connexion) ---------- */
    .auth-page .auth-options {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1.2rem 1.6rem;
        font-size: 1.4rem;
    }

    .auth-page .auth-options .form-check {
        display: flex;
        align-items: center;
        gap: .9rem;
        margin: 0;
        padding-left: 0;
    }

    .auth-page .auth-options .form-check-input {
        width: 1.9rem;
        height: 1.9rem;
        margin: 0;
        flex: 0 0 auto;
        border-width: 1.5px;
        cursor: pointer;
    }

    .auth-page .auth-options .form-check-input:checked {
        background-color: var(--auth-accent);
        border-color: var(--auth-accent);
    }

    .auth-page .auth-options .form-check-label {
        color: var(--auth-muted);
        font-size: 1.4rem;
        font-weight: 600;
        cursor: pointer;
    }

    /* ---------- Liens ---------- */
    .auth-page .auth-link {
        color: var(--auth-navy);
        font-weight: 600;
        text-decoration: none;
    }

    .auth-page .auth-link:hover,
    .auth-page .auth-link:focus-visible {
        color: var(--auth-navy-hover);
        text-decoration: underline;
        text-underline-offset: .3rem;
    }

    /* ---------- Bouton principal ---------- */
    .auth-page .auth-btn {
        display: block;
        width: 100%;
        padding: 1.7rem 2rem;
        border: 0;
        border-radius: var(--auth-radius);
        background: var(--auth-accent);
        color: #fff;
        font-family: inherit;
        font-size: 1.7rem;
        font-weight: 700;
        line-height: 1.3;
        letter-spacing: .01em;
        cursor: pointer;
        transition: background-color .18s ease, transform .18s ease,
                    box-shadow .18s ease;
    }

    .auth-page .auth-btn:hover,
    .auth-page .auth-btn:focus-visible {
        background: var(--auth-accent-hover);
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 1rem 2rem rgba(255, 165, 0, .3);
    }

    /* ---------- Pied de formulaire ---------- */
    .auth-page .auth-actions {
        display: grid;
        gap: 1.6rem;
    }

    .auth-page .auth-note {
        margin: 0;
        text-align: center;
        font-size: 1.4rem;
        color: var(--auth-muted);
    }

    /* ---------- Adaptation mobile ---------- */
    @media (max-width: 575.98px) {
        .auth-page {
            padding-block: 2rem;
        }

        .auth-page .auth-card {
            padding: 2.4rem 1.8rem;
            border-radius: 1.6rem;
        }

        .auth-page .auth-title {
            font-size: 2.3rem;
        }

        .auth-page .auth-fields__pair {
            grid-template-columns: 1fr;
        }

        .auth-page .form-floating > .form-control {
            height: 5.8rem;
            min-height: 5.8rem;
            padding-top: 2.8rem;
        }

        .auth-page .auth-options {
            justify-content: center;
            text-align: center;
        }
    }
</style>
