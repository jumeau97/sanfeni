{% extends 'base_admin.html.twig' %}

{% block title %}Nouveau compte{% endblock %}
{% block page_title %}Nouveau compte utilisateur{% endblock %}

{% import 'admin/_macros.html.twig' as ui %}

{% block body %}
    <div class="admin-card" style="max-width: 860px;">
        <div class="admin-card-header">
            <div>
                <h2 class="admin-card-title">Créer un compte</h2>
                <p class="admin-card-sub mb-0">
                    Laissez le mot de passe vide : un mot de passe provisoire sera généré et envoyé par e-mail.
                </p>
            </div>
            {{ ui.back(path('admin_user_index')) }}
        </div>

        {% include 'admin/user/_form.html.twig' with {
            'form': form,
            'submit_label': 'Créer le compte',
            'back_url': path('admin_user_index')
        } %}
    </div>
{% endblock %}
