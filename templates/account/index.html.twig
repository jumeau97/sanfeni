{% extends 'base.html.twig' %}

{% block title %}Mon compte{% endblock %}

{% block stylesheets %}
    {% include 'account/_account_styles.html.twig' %}
    <style>
        /* Page /account — tuiles de raccourcis.
           Palette, en-tête, boutons et états vides viennent de
           account/_account_styles.html.twig. */

        .account-page .account-head p {
            font-size: 1.5rem;
            line-height: 1.6;
            color: var(--acc-text);
            margin: 0;
        }

        .account-page .account-head strong {
            color: var(--acc-title);
            font-weight: 600;
        }

        /* --- Tuile --- */
        .account-page .account-tile {
            display: flex;
            align-items: center;
            gap: 1.6rem;
            padding: 2rem;
            background: #fff;
            border: 1px solid var(--acc-line);
            border-radius: 1.4rem;
            text-decoration: none;
            color: inherit;
            transition: border-color .25s ease, box-shadow .25s ease, transform .25s ease;
        }

        .account-page .account-tile:hover,
        .account-page .account-tile:focus-visible {
            border-color: var(--acc-primary);
            box-shadow: 0 10px 24px rgba(8, 44, 106, .08);
            transform: translateY(-3px);
            color: inherit;
        }

        .account-page .account-tile:focus-visible {
            outline: 2px solid var(--acc-primary);
            outline-offset: 2px;
        }

        .account-page .tile-icon {
            flex: 0 0 4.8rem;
            width: 4.8rem;
            height: 4.8rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 1.2rem;
            background: rgba(8, 44, 106, .07);
            color: var(--acc-primary);
            transition: background-color .25s ease, color .25s ease;
        }

        .account-page .tile-icon svg {
            width: 2.2rem;
            height: 2.2rem;
            fill: currentColor;
        }

        .account-page .account-tile:hover .tile-icon {
            background: var(--acc-primary);
            color: #fff;
        }

        .account-page .tile-body {
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .account-page .tile-title {
            font-size: 1.6rem;
            font-weight: 600;
            color: var(--acc-title);
            line-height: 1.4;
        }

        .account-page .tile-text {
            font-size: 1.3rem;
            color: var(--acc-text);
            margin-top: 0.3rem;
            line-height: 1.4;
        }

        .account-page .tile-arrow {
            margin-left: auto;
            flex: 0 0 auto;
            color: #B9BAC4;
            display: flex;
            transition: color .25s ease, transform .25s ease;
        }

        .account-page .tile-arrow svg {
            width: 1.6rem;
            height: 1.6rem;
            fill: currentColor;
        }

        .account-page .account-tile:hover .tile-arrow {
            color: var(--acc-primary);
            transform: translateX(3px);
        }

        /* --- Tuile déconnexion (accent) --- */
        .account-page .account-tile--logout .tile-icon {
            background: rgba(255, 165, 0, .12);
            color: #E08900;
        }

        .account-page .account-tile--logout:hover {
            border-color: var(--acc-accent);
            box-shadow: 0 10px 24px rgba(255, 165, 0, .15);
        }

        .account-page .account-tile--logout:hover .tile-icon {
            background: var(--acc-accent);
            color: #fff;
        }

        .account-page .account-tile--logout:hover .tile-arrow {
            color: var(--acc-accent);
        }

        /* --- Responsive --- */
        @media (max-width: 576px) {
            .account-page .account-tile {
                padding: 1.6rem;
                gap: 1.4rem;
            }

            .account-page .tile-icon {
                flex-basis: 4.4rem;
                width: 4.4rem;
                height: 4.4rem;
            }

            .account-page .tile-text {
                display: none;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <section class="user-profile account-page">
        <div class="container">

            <header class="account-head">
                <div>
                    <h1>Mon compte</h1>
                    <p>
                        Bienvenue <strong>{{ app.user.firstname }}</strong> —
                        gérez vos informations, vos commandes et vos adresses.
                    </p>
                </div>
            </header>

            <div class="acc-grid">

                {# Modifier le mot de passe #}
                <a href="{{ path('account_password') }}" class="account-tile">
                    <span class="tile-icon">
