{# ==================================================================
   FICHE PRODUIT — composant LiveComponent.

   Structure :
     · galerie Swiper (image principale + miniatures cliquables)
     · panneau d'achat : boutique, titre, prix, stock, description
     · sélecteurs d'options (couleur / taille / autre) pilotés par
       Stimulus `product-options`
     · récapitulatif de sélection, quantité, CTA

   Le payload JSON embarqué contient la matrice complète des variations :
   c'est lui qui permet à Stimulus de désactiver instantanément une
   combinaison introuvable. Le serveur revalide tout à l'ajout
   (@see ProductDetails::addToCart).

   ⚠ Convention de taille du projet : public/css/style.css déclare
     `html { font-size: 10px }` → 1rem = 10px (et non 16px).
     Les styles sont scopés sous .wb-details (détails.html.twig).
   ================================================================== #}

{% set payload        = this.getOptionsPayload() %}
{% set optionGroups   = this.getOptionGroups() %}
{% set effectivePrice = this.effectivePrice() %}
{% set hasPromo       = product.isPromotion and product.offPercent %}
{% set needsSelection = optionGroups|length > 0 %}
{% set totalStock     = this.getTotalStock() %}
{% set outOfStock     = totalStock is not null and totalStock <= 0 %}

{# État de disponibilité — identique côté serveur et côté Stimulus. #}
{% if outOfStock %}
    {% set stockClass = 'is-out' %}
    {% set stockLabel = 'Rupture de stock' %}
{% elseif totalStock is not null %}
    {% set stockClass = totalStock <= 5 ? 'is-low' : 'is-ok' %}
    {% set stockLabel = totalStock <= 5
        ? 'Plus que ' ~ totalStock ~ ' en stock'
        : 'En stock' %}
{% else %}
    {% set stockClass = '' %}
    {% set stockLabel = '' %}
{% endif %}

{# NB : « data-controller » doit être fusionné en UNE seule balise.
   HTML supprime les attributs en double : écrire {{ attributes }} puis
   data-controller="product-options" faisait perdre « product-options »
   (le 1er, « live », gagnait) → le contrôleur ne s'exécutait jamais.
   defaults() préfixe nos valeurs à celles du composant (API UX). #}
<div class="product-info-section"
     {{ attributes.defaults(stimulus_controller('product-options', {
         payload: payload,
         productId: product.id
     })) }}>

    <div class="row g-4">

        {# ============================================================
           1. GALERIE
           ============================================================ #}
        <div class="col-md-6">
            <div class="wb-gallery">
                <div class="swiper product-top">
                    <div class="swiper-wrapper">
                        <div class="swiper-slide">
                            <img src="{{ asset('images/products/' ~ product.illustration) }}"
                                 alt="{{ product.name }}"
                                 decoding="async">
                        </div>
                        {% for item in product.albums %}
                            <div class="swiper-slide">
                                <img src="{{ asset('images/products/' ~ item.illustration) }}"
                                     alt="{{ product.name }} — vue {{ loop.index }}"
                                     decoding="async">
                            </div>
                        {% endfor %}
                    </div>
                </div>

                {# Miniatures : masquées quand il n'y a qu'une seule photo,
                   sinon on afficherait un carrousel d'une case. #}
                {% if this.hasGallery() %}
                    <div class="swiper product-bottom">
                        <div class="swiper-wrapper">
                            <div class="swiper-slide">
                                <img src="{{ asset('images/products/' ~ product.illustration) }}"
                                     alt="Miniature principale" decoding="async">
                            </div>
                            {% for photo in product.albums %}
                                <div class="swiper-slide">
                                    <img src="{{ asset('images/products/' ~ photo.illustration) }}"
                                         alt="Miniature {{ loop.index }}" decoding="async">
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                {% if hasPromo %}
                    <span class="wb-flag">-{{ product.offPercent }}%</span>
                {% endif %}
            </div>
        </div>

        {# ============================================================
           2. PANNEAU D'ACHAT
           ============================================================ #}
        <div class="col-md-6">
            <div class="wb-buy">

                <span class="wb-shop-badge">
                    <i class="fas fa-store" aria-hidden="true"></i>
                    {{ product.shop ? product.shop.name : 'Sanfeni' }}
                </span>

                <h1 class="wb-title">{{ product.name }}</h1>

                {# ---------- Prix ---------- #}
                <div class="price-section">
                    <span class="wb-price {{ hasPromo ? '' : 'wb-price--plain' }}"
                          data-product-options-target="price">
                        {{ effectivePrice is not null ? effectivePrice|number_format(0, ',', ' ') : '—' }} FCFA
                    </span>

                    {% if hasPromo %}
                        <span class="wb-price-old">{{ product.price|number_format(0, ',', ' ') }} FCFA</span>
                        <span class="wb-price-badge">-{{ product.offPercent }}%</span>
                        <span class="wb-save">
                            Économie
                            {{ (product.price - effectivePrice)|number_format(0, ',', ' ') }} FCFA
                        </span>
                    {% endif %}
                </div>

                {# ---------- Disponibilité ----------
                   Rendue aussi côté serveur : la mention reste correcte sans
                   JS. Stimulus la recalcule ensuite à chaque sélection. #}
                <span class="wb-stock {{ stockClass }}"
                      data-product-options-target="stock">{{ stockLabel }}</span>

                {# ---------- Dernier refus serveur (variante en rupture…) ---------- #}
                <div class="wb-option-error{% if not error %} is-hidden{% endif %}"
                     role="alert"
                     data-product-options-target="error">{{ error }}</div>

                {# ---------- Description ---------- #}
                {% if product.description %}
                    <div class="wb-desc-wrap">
                        <p class="wb-desc">{{ product.description|raw }}</p>
                    </div>
                {% endif %}

                {# ============================================================
                   3. SÉLECTION DES OPTIONS (couleurs, tailles, …)
                   ============================================================ #}
                {% if optionGroups %}
                    <hr class="wb-rule">

                    <div class="wb-options">
                        {% for group in optionGroups %}
                            <fieldset class="wb-option-group">
                                <legend class="wb-option-legend">
                                    <span class="wb-option-name">{{ group.name }}</span>
                                    <span class="wb-option-required">
                                        {{ group.type == 'color' ? 'Choisissez une couleur' : 'Choisissez une taille' }}
                                    </span>
                                </legend>

                                {% if group.type == 'color' %}
                                    {# Pastille colorée + libellé : lisible et accessible,
                                       même quand le code couleur est absent. #}
                                    <div class="wb-swatches">
                                        {% for option in group.options %}
                                            <button type="button"
                                                    class="wb-swatch"
                                                    data-product-options-target="option"
                                                    data-attribute-id="{{ option.attributeId }}"
                                                    data-value-id="{{ option.id }}"
                                                    data-action="product-options#select"
                                                    aria-pressed="false"
                                                    {% if not option.available %}disabled{% endif %}>
                                                <span class="wb-swatch__dot"
                                                      style="background: {{ option.color ?: '#ffffff' }}"></span>
                                                <span class="wb-swatch__label">{{ option.label }}</span>
                                                {% if not option.available %}
                                                    <span class="wb-out-badge">épuisé</span>
                                                {% endif %}
                                            </button>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    {# Grille de puces (tailles, références…) #}
                                    <div class="wb-chips">
                                        {% for option in group.options %}
                                            <button type="button"
                                                    class="wb-chip"
                                                    data-product-options-target="option"
                                                    data-attribute-id="{{ option.attributeId }}"
                                                    data-value-id="{{ option.id }}"
                                                    data-action="product-options#select"
                                                    aria-pressed="false"
                                                    {% if not option.available %}disabled{% endif %}>
                                                <span class="wb-chip__label">{{ option.label }}</span>
                                                {% if not option.available %}
                                                    <span class="wb-out-badge">épuisé</span>
                                                {% endif %}
                                            </button>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </fieldset>
                        {% endfor %}
                    </div>

                    {# Récapitulatif — mis à jour en direct par Stimulus #}
                    <div class="wb-selection">
                        <span class="wb-selection__label">Votre sélection</span>
                        <span class="wb-selection__value is-empty"
                              data-product-options-target="summary">Sélectionnez une option</span>
                    </div>
                {% endif %}

                {# ============================================================
                   4. QUANTITÉ + APPEL À L'ACTION
                   ============================================================ #}
                <div class="wb-cta-row">

                    <div class="wb-qty">
                        <span class="wb-qty__label">Quantité</span>
                        <div class="wb-stepper" role="group" aria-label="Quantité">
                            <button type="button"
                                    class="wb-stepper__btn"
                                    data-role="qty-decrease"
                                    data-action="product-options#decrease"
                                    aria-label="Diminuer la quantité">&minus;</button>

                            <span class="wb-stepper__value"
                                  data-product-options-target="qty"
                                  aria-live="polite">1</span>

                            <button type="button"
                                    class="wb-stepper__btn"
                                    data-role="qty-increase"
                                    data-action="product-options#increase"
                                    aria-label="Augmenter la quantité">+</button>
                        </div>
                    </div>

                    <button type="button"
                            class="wb-cta"
                            data-product-options-target="cta"
                            {# État sûr par défaut : tant que Stimulus n'a pas
                               validé la sélection (ou sans JS), le bouton ne
                               doit pas laisser croire qu'on peut commander. #}
                            {% if needsSelection or outOfStock %}disabled{% endif %}
                            {# prepareAdd copie quantité/variante dans les params
                               LiveComponent AVANT live#action (ordre du data-action). #}
                            data-action="product-options#prepareAdd live#action"
                            data-live-action-param="addToCart"
                            data-live-quantity-param="1">

                        <svg class="wb-cta__icon" width="18" height="18" viewBox="0 0 16 16"
                             fill="currentColor" aria-hidden="true">
                            <path d="M8 1a2.5 2.5 0 0 1 2.5 2.5V4h-5v-.5A2.5 2.5 0 0 1 8 1zm3.5 3v-.5a3.5 3.5 0 1 0-7 0V4H1v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4h-3.5z"/>
                        </svg>
                        <span data-role="cta-label">{% if outOfStock %}Rupture de stock{% elseif needsSelection %}Choisissez vos options{% else %}Ajouter au panier{% endif %}</span>
                    </button>
                </div>

                <p class="wb-pay"><i class="fas fa-lock" aria-hidden="true"></i> Paiement sécurisé</p>

                {# ---------- Catégories ---------- #}
                {% if product.categories|length %}
                    <div class="wb-cats">
                        <p class="wb-cats-label">
                            Catégories :
                            {% for categ in product.categories %}
                                <a href="{{ path('app_home', {'slug': categ.name}) }}">{{ categ.name }}</a>{{ not loop.last ? ',' }}
                            {% endfor %}
                        </p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
