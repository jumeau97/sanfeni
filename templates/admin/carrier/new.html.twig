{% extends 'base_admin.html.twig' %}

{% block title %}Nouveau transporteur{% endblock %}
{% block page_title %}Nouveau transporteur{% endblock %}

{% import 'admin/_macros.html.twig' as ui %}

{% block body %}
    <div class="admin-card" style="max-width: 760px;">
        <div class="admin-card-header">
            <div>
                <h2 class="admin-card-title">Créer un transporteur</h2>
                <p class="admin-card-sub mb-0">Option de livraison proposée à tous les clients.</p>
            </div>
            {{ ui.back(path('admin_carrier_index')) }}
        </div>

        {% include 'admin/carrier/_form.html.twig' with {
            'form': form,
            'submit_label': 'Créer le transporteur',
            'back_url': path('admin_carrier_index')
        } %}
    </div>
{% endblock %}
