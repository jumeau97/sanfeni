{% extends 'base_admin.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}
{% block page_title %}Fiche produit{% endblock %}

{% import 'admin/_macros.html.twig' as ui %}

{% block body %}

    <div class="admin-card-header">
        <div>
            <h2 class="admin-card-title mb-1" style="font-size:1.1rem;">{{ product.name }}</h2>
            <p class="admin-card-sub mb-0">
                {{ ui.tag(product.state) }}
                {% if product.isPromotion and product.offPercent %}
                    <span class="admin-tag admin-tag-warn">Promo -{{ product.offPercent }}%</span>
                {% endif %}
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            {{ ui.back(path('admin_product_index'), 'Retour à la liste') }}
            <a href="{{ path('admin_product_edit', {id: product.id}) }}" class="btn btn-admin">
                <i class="fas fa-pen"></i> Modifier
            </a>
            {{ ui.delete_button(
                path('admin_product_delete', {id: product.id}),
                'Supprimer',
                'Supprimer définitivement ce produit « ' ~ product.name ~ ' » ?'
            ) }}
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-5">
            <div class="admin-card">
                <h3 class="admin-card-title">Image principale</h3>
                {% if product.illustration %}
                    <img class="admin-image-preview" style="width:100%; height:240px;"
                         src="{{ asset('images/products/' ~ product.illustration) }}"
                         alt="{{ product.name }}">
                {% else %}
                    <div class="admin-empty" style="padding:24px 10px;">
                        <i class="fas fa-image"></i>
                        <p>Aucune image</p>
                    </div>
                {% endif %}

                {% if product.albums|length > 0 %}
                    <div class="admin-section-title">Galerie ({{ product.albums|length }})</div>
                    <div class="d-flex flex-wrap gap-2">
                        {% for album in product.albums %}
                            {% if album.illustration %}
                                <img src="{{ vich_uploader_asset(album) }}"
                                     alt="Photo {{ loop.index }}"
                                     style="width:70px;height:70px;object-fit:cover;border-radius:8px;border:1px solid var(--adm-line);">
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="col-lg-7">
            <div class="admin-card">
                <h3 class="admin-card-title">Détails</h3>

                <dl class="admin-meta">
                    <div>
                        <dt>Prix</dt>
                        <dd>
                            {% if product.isPromotion and product.offPercent %}
                                <span class="admin-amount-promo">{{ product.promoPrice|fcfa }}</span>
                                <span class="admin-cell-sub"><s>{{ product.price|fcfa }}</s></span>
                            {% else %}
                                {{ ui.amount(product.price) }}
                            {% endif %}
                        </dd>
                    </div>
                    <div>
                        <dt>Stock</dt>
                        <dd>{{ product.stock is null ? 'non géré' : product.stock }}</dd>
                    </div>
                    <div>
                        <dt>Type</dt>
                        <dd>{{ product.type|capitalize }}</dd>
                    </div>
                    <div>
                        <dt>Slug</dt>
                        <dd>/{{ product.slug }}</dd>
                    </div>
                    <div>
                        <dt>Boutique</dt>
                        <dd>{{ product.shop ? product.shop.name : '—' }}</dd>
                    </div>
                    <div>
                        <dt>Créé le</dt>
                        <dd>{{ product.createdAt ? product.createdAt|date('d/m/Y H:i') : '—' }}</dd>
                    </div>
                    <div>
                        <dt>Catégories</dt>
                        <dd>
                            {% for category in product.categories %}
                                <span class="admin-badge-soft">{{ category.name }}</span>
                            {% else %}
                                —
                            {% endfor %}
                        </dd>
                    </div>
                </dl>

                {% if product.description %}
                    <div class="admin-section-title">Description</div>
                    <p style="white-space: pre-line; font-size:.87rem; color: var(--adm-muted);">
                        {{ product.description }}
                    </p>
                {% endif %}
            </div>

            {% if product.productVariations|length > 0 %}
                <div class="admin-card mt-3">
                    <h3 class="admin-card-title">Déclinaisons ({{ product.productVariations|length }})</h3>

                    <div class="admin-table-wrap">
                        <table class="admin-table">
                            <thead>
                            <tr>
                                <th>Combinaison</th>
                                <th>Prix</th>
                                <th>Stock</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for variation in product.productVariations %}
                                <tr>
                                    <td>
                                        {% for value in variation.attributes %}
                                            <span class="admin-badge-soft">
                                                {% if value.color %}
                                                    <span class="admin-color-dot" style="background: {{ value.color }}"></span>
                                                {% endif %}
                                                {{ value.attribute ? value.attribute.name ~ ' : ' : '' }}{{ value.value }}
                                            </span>
                                        {% else %}
                                            <span class="admin-cell-sub">—</span>
                                        {% endfor %}
                                    </td>
                                    <td>
                                        {% if variation.price %}
                                            {{ ui.amount(variation.price) }}
                                        {% else %}
                                            <span class="admin-cell-sub">prix du produit</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if variation.stock > 0 %}
                                            {{ variation.stock }}
                                        {% else %}
                                            <span class="admin-tag admin-tag-danger">rupture</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    {% if product.type != 'variable' %}
                        <p class="admin-cell-sub mb-0 mt-2">
                            <i class="fas fa-exclamation-triangle"></i>
                            Ce produit n'est pas déclaré « variable » : ces déclinaisons sont ignorées par la boutique.
                        </p>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>

{% endblock %}
