{% extends 'base.html.twig' %}

{% block title %}Mes adresses{% endblock %}

{% block stylesheets %}
    {% include 'account/_account_styles.html.twig' %}
    <style>
        /* Page /account/address — cartes d'adresses. */

        .account-page .acc-address__top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.2rem;
            margin-bottom: 1.8rem;
        }

        .account-page .acc-address__name {
            font-family: 'Inter', sans-serif;
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--acc-title);
            margin: 0 0 1.6rem;
        }

        /* Menu « ... » */
        .account-page .acc-dots {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 3.4rem;
            height: 3.4rem;
            border-radius: 50%;
            background: transparent;
            color: var(--acc-text);
            font-size: 1.6rem;
            transition: background-color .2s ease, color .2s ease;
        }

        .account-page .acc-dots:hover,
        .account-page .acc-dots[aria-expanded="true"] {
            background: var(--acc-field);
            color: var(--acc-primary);
        }

        .account-page .dropdown-menu {
            border: 1px solid var(--acc-line);
            border-radius: 1rem;
            padding: 0.6rem;
            box-shadow: 0 10px 24px rgba(8, 44, 106, 0.08);
        }

        .account-page .dropdown-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            font-size: 1.4rem;
            font-weight: 500;
            color: var(--acc-title);
            padding: 1rem 1.2rem;
            border-radius: 0.6rem;
        }

        .account-page .dropdown-item:hover {
            background: var(--acc-field);
            color: var(--acc-primary);
        }

        .account-page .dropdown-item i {
            width: 1.6rem;
            font-size: 1.3rem;
            text-align: center;
        }

        .account-page .dropdown-item--danger,
        .account-page .dropdown-item--danger:hover {
            color: #C0392B;
        }

        .account-page .dropdown-item--danger:hover {
            background: #FDEDEC;
        }

        /* Clé / valeur */
        .account-page .acc-kv {
            display: flex;
            gap: 1.2rem;
            font-size: 1.4rem;
            line-height: 1.5;
            padding: 0.7rem 0;
        }

        .account-page .acc-kv + .acc-kv {
            border-top: 1px solid var(--acc-line);
            padding-top: 1.4rem;
        }

        .account-page .acc-kv__k {
            flex: 0 0 7rem;
            color: var(--acc-text);
        }

        .account-page .acc-kv__v {
            color: var(--acc-title);
            font-weight: 500;
            word-break: break-word;
        }
    </style>
{% endblock %}

{% block body %}
    <section class="user-profile account-page">
        <div class="container">

            <header class="account-head">
                <div>
                    <h1>Mes adresses</h1>
                    <a href="{{ path('app_account') }}" class="account-back">
                        <i class="fas fa-arrow-left"></i> Retourner à mon compte
                    </a>
                </div>
                <a href="{{ path('account_add_address') }}" class="acc-btn acc-btn--outline">
                    <i class="fas fa-plus"></i> Ajouter une adresse
                </a>
            </header>

            <div class="acc-grid">
                {% for address in addresses %}
                    <article class="acc-card acc-address">
                        <div class="acc-address__top">
                            <span class="acc-badge">
                                <i class="fas fa-map-marker-alt"></i> Adresse {{ loop.index }}
                            </span>
                            <div class="dropdown">
                                <button class="acc-dots" type="button" data-bs-toggle="dropdown" aria-label="Options de l'adresse">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="{{ path('account_edit_address', {'id': address.id}) }}">
                                            <i class="fas fa-pencil-alt"></i> Modifier
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item dropdown-item--danger" href="#">
                                            <i class="fas fa-trash-alt"></i> Supprimer
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <h2 class="acc-address__name">{{ address.name|default('Maison') }}</h2>

                        <div class="acc-kv">
                            <span class="acc-kv__k">Rue</span>
                            <span class="acc-kv__v">{{ address.address }}</span>
                        </div>
                        <div class="acc-kv">
                            <span class="acc-kv__k">Ville</span>
                            <span class="acc-kv__v">{{ address.city }} ({{ address.country }})</span>
                        </div>
                        <div class="acc-kv">
                            <span class="acc-kv__k">Tel</span>
                            <span class="acc-kv__v">{{ address.phone }}</span>
                        </div>
                    </article>
                {% else %}
                    <div class="acc-empty">
                        <i class="fas fa-map"></i>
                        <p>Vous n'avez pas encore enregistré d'adresse.</p>
                        <a href="{{ path('account_add_address') }}" class="acc-btn acc-btn--primary">
                            <i class="fas fa-plus"></i> Ajouter une adresse
                        </a>
                    </div>
                {% endfor %}
            </div>

        </div>
    </section>
{% endblock %}
