{% extends 'base.html.twig' %}

{% block title %}Modifier mon mot de passe{% endblock %}

{% block stylesheets %}
    {% include 'account/_account_styles.html.twig' %}
    <style>
        /* Page /account/password — formulaire unique centré.
           Les anciennes classes .login-section / .review-form de
           public/css/style.css imposaient une largeur fixe (51.2rem)
           et une hauteur fixe (63rem) : on ne les utilise plus.
           La largeur et le centrage viennent de .account-column. */

        .account-page .acc-form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1.6rem 2rem;
        }

        .account-page .acc-form-grid .mb-3 {
            margin-bottom: 0;
        }

        .account-page .acc-field--full {
            grid-column: 1 / -1;
        }

        .account-page .acc-sep {
            height: 1px;
            background: var(--acc-line);
            margin: 2.4rem 0;
        }

        @media (max-width: 576px) {
            .account-page .acc-form-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <section class="user-profile account-page">
        <div class="container">
            <div class="account-column">

                <header class="account-head">
                    <div>
                        <h1>Mon mot de passe</h1>
                        <a href="{{ path('app_account') }}" class="account-back">
                            <i class="fas fa-arrow-left"></i> Retourner à mon compte
                        </a>
                    </div>
                </header>

                {% if notifications %}
                    <div class="acc-alert">{{ notifications }}</div>
                {% endif %}

                <div class="acc-card">
                    {{ form_start(form) }}
                        <h2 class="acc-card__title">Mes informations</h2>
                        <div class="acc-form-grid">
                            <div class="acc-field--full">{{ form_row(form.email) }}</div>
                            <div>{{ form_row(form.firstname) }}</div>
                            <div>{{ form_row(form.lastname) }}</div>
                        </div>

                        <div class="acc-sep"></div>

                        <h2 class="acc-card__title">Sécurité</h2>
                        <div class="acc-form-grid">
                            <div class="acc-field--full">{{ form_row(form.old_password) }}</div>
                            <div>{{ form_row(form.new_password.first) }}</div>
                            <div>{{ form_row(form.new_password.second) }}</div>
                        </div>

                        <div class="form-actions">
                            {{ form_widget(form.submit, {
                                'label': 'Mettre à jour',
                                'attr': {'class': 'acc-btn acc-btn--primary'}
                            }) }}
                        </div>
                    {{ form_end(form, { render_rest: false }) }}
                </div>

            </div>
        </div>
    </section>
{% endblock %}
