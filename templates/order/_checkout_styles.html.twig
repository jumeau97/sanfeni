{#
    Styles partagés des pages de commande — boutique vitrine.
    Inclus par : templates/order/index.html.twig   (validation de commande)
                 templates/order/add.html.twig      (récapitulatif + paiement)

    Même langage visuel que .wb-cart (panier) et .wb-confirm (confirmation) :
    cartes blanches, filets 1 px, bleu nuit #082C6A pour la structure et les
    montants, orange de marque #FFA500 pour l'action et la sélection.

    Convention de taille du projet (public/css/style.css) :
        html { font-size: 10px }  →  1rem = 10px (et non 16px).
    Police : Inter — famille unique du site, déjà chargée par
    public/css/style.css (@import) et base.html.twig.
#}
<style>
    /* ============================================================ *
     *  Jetons de couleur                                          *
     * ============================================================ */
    .wb-checkout {
        --wb-navy: #082C6A;
        --wb-navy-hover: #0b3177;
        --wb-accent: #FFA500;
        --wb-accent-hover: #EEA41E;
        --wb-accent-tint: #FFF7EA;
        --wb-accent-line: #FFDCAE;
        --wb-accent-ink: #A66200;
        --wb-ink: #1b1d21;
        --wb-muted: #767b83;
        --wb-line: #e8eaee;
        --wb-surface: #fff;
        --wb-soft: #f6f7f9;
        --wb-radius: 14px;
        --wb-radius-sm: 12px;

        background: #F8F8F8;
        color: var(--wb-ink);
        font-size: 1.5rem;
        line-height: 1.5;
        padding-block: clamp(2.4rem, 4vw, 4.5rem);
    }

    /* ============================================================ *
     *  En-tête de page — filet de marque comme sur le panier       *
     * ============================================================ */
    .wb-checkout .wb-checkout-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px 20px;
        margin-bottom: 2.4rem;
        padding-bottom: 1.6rem;
        border-bottom: 1px solid var(--wb-line);
    }

    .wb-checkout .wb-checkout-title {
        position: relative;
        margin: 0;
        padding-top: 13px;
        font-size: clamp(2rem, 2.5vw, 2.4rem);
        font-weight: 800;
        letter-spacing: -.02em;
        line-height: 1.25;
        color: var(--wb-ink);
    }

    .wb-checkout .wb-checkout-title::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 38px;
        height: 4px;
        border-radius: 3px;
        background: var(--wb-navy);
    }

    .wb-checkout .wb-checkout-sub {
        margin: 0;
        font-size: 1.4rem;
        color: var(--wb-muted);
    }

    /* ============================================================ *
     *  Panneaux                                                    *
     * ============================================================ */
    .wb-checkout .wb-panel {
        background: var(--wb-surface);
        border: 1px solid var(--wb-line);
        border-radius: var(--wb-radius);
        overflow: hidden;
    }

    .wb-checkout .wb-panel-head {
        display: flex;
        align-items: center;
        gap: 1.2rem;
        padding: 1.4rem 1.8rem;
        border-bottom: 1px solid var(--wb-line);
        background: var(--wb-surface);
    }

    .wb-checkout .wb-panel-title {
        /* Le titre occupe la largeur restante : les badges/indicateurs
           placés après lui sont alignés à droite de la barre d'en-tête. */
        margin: 0 auto 0 0;
        font-size: 1.7rem;
        font-weight: 800;
        letter-spacing: -.01em;
        line-height: 1.3;
        color: var(--wb-ink);
    }

    .wb-checkout .wb-panel-body {
        padding: 1.8rem;
    }

    /* Pastille numérotée (étape) */
    .wb-checkout .wb-badge {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.8rem;
        height: 2.8rem;
        border-radius: 50%;
        background: var(--wb-navy);
        color: #fff;
        font-size: 1.4rem;
        font-weight: 800;
        font-style: normal;
    }

    /* Pastille icône (teinte orange, touche de marque) */
    .wb-checkout .wb-badge--ico {
        background: var(--wb-accent-tint);
        color: var(--wb-accent-ink);
        font-size: 1.6rem;
    }

    .wb-checkout .wb-badge--ico i {
        font-style: normal;
    }

    /* Compteur d'articles */
    .wb-checkout .wb-chip {
        margin-left: auto;
        padding: .4rem 1rem;
        border: 1px solid var(--wb-line);
        border-radius: 999px;
        background: var(--wb-soft);
        color: var(--wb-muted);
        font-size: 1.2rem;
        font-weight: 700;
        white-space: nowrap;
    }

    /* ============================================================ *
     *  Barre d'outils (libellé + action secondaire)                *
     * ============================================================ */
    .wb-checkout .wb-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem 1.2rem;
        margin-bottom: 1.4rem;
    }

    .wb-checkout .wb-eyebrow {
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--wb-muted);
    }

    /* Titre de section suivi d'options (moyen de paiement) */
    .wb-checkout .wb-pay-title {
        margin: 2rem 0 1.2rem;
    }

    .wb-checkout .wb-link {
        display: inline-flex;
        align-items: center;
        gap: .6rem;
        padding: .7rem 1.4rem;
        border: 1px solid var(--wb-line);
        border-radius: 999px;
        background: var(--wb-surface);
        color: var(--wb-navy);
        font-size: 1.3rem;
        font-weight: 700;
        text-decoration: none;
        transition: background-color .16s ease, border-color .16s ease,
                    color .16s ease;
    }

    .wb-checkout .wb-link:hover {
        background: var(--wb-soft);
        border-color: #c9d2e3;
        color: var(--wb-navy);
    }

    /* ============================================================ *
     *  Options sélectionnables (adresses, transporteurs, paiement) *
     *  Rendu Symfony : .form-check > input.form-check-input +       *
     *  label.form-check-label — pastilles en position absolue.      *
     * ============================================================ */
    .wb-checkout .custom-form-radio,
    .wb-checkout .wb-options {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .wb-checkout .custom-form-radio .form-check,
    .wb-checkout .wb-option {
        position: relative;
        display: block;
        margin: 0;
        padding: 1.3rem 1.5rem 1.3rem 4.6rem;
        border: 1px solid var(--wb-line);
        border-radius: var(--wb-radius-sm);
        background: var(--wb-surface);
        cursor: pointer;
        transition: border-color .16s ease, background-color .16s ease,
                    box-shadow .16s ease;
    }

    .wb-checkout .custom-form-radio .form-check:hover,
    .wb-checkout .wb-option:hover {
        border-color: var(--wb-accent-line);
        background: #FFFCF7;
    }

    /* État sélectionné (:has — Chrome 105+, Safari 15.4+, FF 121+) */
    .wb-checkout .custom-form-radio .form-check:has(.form-check-input:checked),
    .wb-checkout .wb-option:has(.form-check-input:checked) {
        border-color: var(--wb-accent);
        background: var(--wb-accent-tint);
        box-shadow: 0 .2rem .9rem rgba(255, 165, 0, .16);
    }

    .wb-checkout .custom-form-radio .form-check .form-check-input,
    .wb-checkout .wb-option .form-check-input {
        position: absolute;
        top: 1.4rem;
        left: 1.5rem;
        float: none;
        width: 1.8rem;
        height: 1.8rem;
        margin: 0;
        background-color: #fff;
        border-width: 1.5px;
        cursor: pointer;
    }

    .wb-checkout .custom-form-radio .form-check-input:checked,
    .wb-checkout .wb-option .form-check-input:checked {
        background-color: var(--wb-accent);
        border-color: var(--wb-accent);
    }

    .wb-checkout .custom-form-radio .form-check-input:focus,
    .wb-checkout .wb-option .form-check-input:focus {
        border-color: var(--wb-accent);
        box-shadow: 0 0 0 .3rem rgba(255, 165, 0, .22);
        outline: 0;
    }

    .wb-checkout .custom-form-radio .form-check-label,
    .wb-checkout .wb-option .wb-option__text {
        display: block;
        margin: 0;
        font-size: 1.4rem;
        font-weight: 600;
        line-height: 1.55;
        color: var(--wb-ink);
        cursor: pointer;
    }

    .wb-checkout .wb-option .wb-option__text i {
        margin-right: .7rem;
        color: var(--wb-navy);
        font-size: 1.6rem;
    }

    /* ============================================================ *
     *  Récapitulatif : articles                                    *
     * ============================================================ */
    .wb-checkout .wb-recap-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .wb-checkout .wb-recap-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1.2rem;
        padding: 1.2rem 0;
        border-bottom: 1px solid var(--wb-line);
    }

    .wb-checkout .wb-recap-row:first-child {
        padding-top: 0;
    }

    .wb-checkout .wb-recap-row:last-child {
        padding-bottom: 0;
        border-bottom: 0;
    }

    .wb-checkout .wb-recap-info {
        min-width: 0;
    }

    .wb-checkout .wb-recap-name {
        display: block;
        font-size: 1.45rem;
        font-weight: 650;
        line-height: 1.4;
        color: var(--wb-ink);
        overflow-wrap: anywhere;
    }

    .wb-checkout .wb-recap-qty {
        display: block;
        margin-top: .3rem;
        font-size: 1.3rem;
        color: var(--wb-muted);
    }

    .wb-checkout .wb-recap-price {
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--wb-ink);
        white-space: nowrap;
    }

    /* ============================================================ *
     *  Détail des coûts (sous-total, port)                         *
     * ============================================================ */
    .wb-checkout .wb-costs {
        display: grid;
        gap: .8rem;
        margin-top: 1.6rem;
        padding-top: 1.6rem;
        border-top: 1px solid var(--wb-line);
    }

    .wb-checkout .wb-cost {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1.2rem;
        font-size: 1.45rem;
    }

    .wb-checkout .wb-cost span {
        color: var(--wb-muted);
    }

    .wb-checkout .wb-cost strong {
        font-weight: 700;
        color: var(--wb-ink);
        text-align: right;
    }

    /* ============================================================ *
     *  Totaux                                                      *
     * ============================================================ */
    .wb-checkout .wb-total {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1.2rem;
    }

    .wb-checkout .wb-total__label {
        font-size: 1.5rem;
        font-weight: 750;
        color: var(--wb-ink);
    }

    .wb-checkout .wb-total__value {
        font-size: 2.4rem;
        font-weight: 800;
        letter-spacing: -.02em;
        color: var(--wb-navy);
        white-space: nowrap;
    }

    /* Total final, souligné d'un filet bleu nuit (signature) */
    .wb-checkout .wb-grand {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1.2rem;
        margin-top: 1.6rem;
        padding-top: 1.6rem;
        border-top: 2px solid var(--wb-navy);
    }

    .wb-checkout .wb-grand__label {
        font-size: 1.4rem;
        font-weight: 800;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--wb-ink);
    }

    .wb-checkout .wb-grand__value {
        font-size: 2.4rem;
        font-weight: 800;
        letter-spacing: -.02em;
        color: var(--wb-navy);
        white-space: nowrap;
    }

    /* ============================================================ *
     *  Adresse / transporteur (récapitulatif)                      *
     * ============================================================ */
    .wb-checkout .wb-address {
        display: flex;
        gap: 1.2rem;
        padding: 1.5rem 1.6rem;
        border: 1px solid var(--wb-line);
        border-radius: var(--wb-radius-sm);
        background: var(--wb-soft);
    }

    .wb-checkout .wb-address__ico {
        flex: 0 0 auto;
        margin-top: .2rem;
        color: var(--wb-navy);
        font-size: 1.8rem;
    }

    .wb-checkout .wb-address__body {
        margin: 0;
        font-size: 1.5rem;
        line-height: 1.65;
        color: var(--wb-ink);
    }

    .wb-checkout .wb-carrier {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1.2rem;
        padding: 1.5rem 1.6rem;
        border: 1px solid var(--wb-line);
        border-radius: var(--wb-radius-sm);
        background: var(--wb-soft);
    }

    .wb-checkout .wb-carrier__name {
        margin: 0 0 .4rem;
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--wb-navy);
    }

    .wb-checkout .wb-carrier__desc {
        margin: 0;
        font-size: 1.4rem;
        line-height: 1.55;
        color: var(--wb-muted);
    }

    .wb-checkout .wb-carrier__price {
        flex: 0 0 auto;
        padding: .5rem 1.1rem;
        border: 1px solid var(--wb-accent-line);
        border-radius: 999px;
        background: var(--wb-accent-tint);
        color: var(--wb-accent-ink);
        font-size: 1.35rem;
        font-weight: 800;
        white-space: nowrap;
    }

    /* ============================================================ *
     *  Bouton principal (orange de marque, comme .auth-btn)        *
     * ============================================================ */
    .wb-checkout .wb-cta {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .8rem;
        width: 100%;
        padding: 1.5rem 1.8rem;
        border: 0;
        border-radius: 12px;
        background: var(--wb-accent);
        color: #fff;
        font-family: inherit;
        font-size: 1.6rem;
        font-weight: 700;
        line-height: 1.3;
        letter-spacing: .01em;
        cursor: pointer;
        transition: background-color .18s ease, transform .18s ease,
                    box-shadow .18s ease;
    }

    .wb-checkout .wb-cta:hover,
    .wb-checkout .wb-cta:focus-visible {
        background: var(--wb-accent-hover);
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 1rem 2rem rgba(255, 165, 0, .3);
    }

    /* ============================================================ *
     *  Note de réassurance                                         *
     * ============================================================ */
    .wb-checkout .wb-note {
        margin: 1.4rem 0 0;
        text-align: center;
        font-size: 1.25rem;
        color: var(--wb-muted);
    }

    .wb-checkout .wb-note i {
        margin-right: .4rem;
        color: var(--wb-navy);
    }

    /* ============================================================ *
     *  Récapitulatif collant (desktop)                             *
     *  Le récap reste collant sous le header épinglé.              *
     * ============================================================ */
    .wb-checkout .wb-sticky-aside {
        top: 20px;
    }

    /* ============================================================ *
     *  Barre d'action : « total + bouton » du récapitulatif.
     *
     *  Desktop : simple bloc empilé dans la carte.
     *  Sous 992px le récapitulatif s'empile SOUS le formulaire :
     *  le CTA descendrait tout en bas de page, on le fige donc pour
     *  que total + « Valider / Confirmer » restent visibles sans
     *  scroller. Le bouton reste un descendant du <form> dans le
     *  DOM : le positionnement fixe ne change rien à sa soumission.
     * ============================================================ */
    .wb-checkout .wb-actionbar {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        margin-top: 1.6rem;
        padding-top: 1.6rem;
        border-top: 1px solid var(--wb-line);
    }

    @media (max-width: 991.98px) {
        .wb-checkout .wb-actionbar {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 1000;
            flex-direction: row;
            align-items: center;
            gap: 1.2rem;
            margin-top: 0;
            padding: 1rem 1.6rem calc(1rem + env(safe-area-inset-bottom));
            background: var(--wb-surface);
            border-top: 1px solid var(--wb-line);
            box-shadow: 0 -.8rem 2.4rem rgba(8, 44, 106, .12);
        }

        /* Spécificité (0,3,0) : doit l'emporter sur la règle propre à la
           page récapitulatif qui masque le total sur desktop. */
        .wb-checkout .wb-actionbar .wb-actionbar__total {
            display: flex;
            flex-direction: column;
            flex: 0 1 auto;
            min-width: 0;
            gap: .2rem;
        }

        .wb-checkout .wb-actionbar .wb-total {
            flex-direction: column;
            align-items: flex-start;
            gap: .2rem;
        }

        .wb-checkout .wb-actionbar .wb-total__label {
            font-size: 1.15rem;
            font-weight: 600;
            color: var(--wb-muted);
            white-space: nowrap;
        }

        /* Sécurité sur écran étroit (320px) : le montant passe plutôt
           en ellipsis que de faire déborder la barre. */
        .wb-checkout .wb-actionbar .wb-total__value {
            font-size: 1.9rem;
            display: block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .wb-checkout .wb-actionbar .wb-actionbar__btn {
            flex: 1 1 auto;
            min-width: 0;
            width: auto;
            overflow: hidden;
            white-space: nowrap;
            padding-top: 1.4rem;
            padding-bottom: 1.4rem;
        }

        /* Le bouton WhatsApp (base.html.twig, fixe en bas à droite)
           remonte au-dessus de la barre au lieu d'être masqué.

           `html body` n'est pas décoratif : le bloc « stylesheets » de
           base.html.twig est rendu AVANT tous les <style> de la page,
           donc la règle `.whatsapp-sticky-btn { bottom: 20px }` arrive
           plus tard dans le document. À spécificité égale elle
           l'emporterait et le bouton resterait au sol, sous la barre
           fixe. html body porte la spécificité à (0,1,2) et l'emporte
           donc quel que soit l'ordre. */
        html body .whatsapp-sticky-btn {
            bottom: calc(84px + env(safe-area-inset-bottom));
        }
    }

    /* ============================================================ *
     *  Adaptation mobile                                            *
     * ============================================================ */
    @media (max-width: 575.98px) {
        .wb-checkout .wb-checkout-head {
            display: block;
        }

        .wb-checkout .wb-checkout-sub {
            margin-top: .8rem;
        }

        .wb-checkout .wb-panel-head {
            padding: 1.2rem 1.4rem;
        }

        .wb-checkout .wb-panel-body {
            padding: 1.4rem;
        }

        .wb-checkout .wb-total__value,
        .wb-checkout .wb-grand__value {
            font-size: 2rem;
        }

        .wb-checkout .wb-carrier {
            flex-direction: column;
            gap: 1rem;
        }

        .wb-checkout .wb-chip {
            display: none;
        }
    }
</style>
