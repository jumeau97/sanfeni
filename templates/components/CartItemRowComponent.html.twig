{# Une ligne du panier. La racine porte {{ attributes }} (id / key) :
   le composant ne peut être remplacé que si cet attribut y est. #}
{% set product = this.productEntity %}

<tr {{ attributes }} class="wb-cart-row">
    {% if product is null %}
        {# Produit supprimé entre-temps : on affiche une ligne neutralisable. #}
        <td class="wb-cart-cell wb-cart-cell--product" colspan="3">
            <span class="wb-cart-name">Ce produit n'est plus disponible</span>
            <button type="button" class="wb-cart-remove"
                    data-action="live#action"
                    data-live-action-param="removeItem">
                <i class="fas fa-trash-alt"></i> Retirer
            </button>
        </td>
    {% else %}
        <td class="wb-cart-cell wb-cart-cell--product">
            <div class="wb-cart-product">
                {% if product.illustration %}
                    <img class="wb-cart-img"
                         src="{{ asset('images/products/' ~ product.illustration) }}"
                         alt="{{ product.name }}"
                         loading="lazy" decoding="async">
                {% else %}
                    <span class="wb-cart-img wb-cart-img--empty">
                        <i class="fas fa-box-open"></i>
                    </span>
                {% endif %}

                <div class="wb-cart-product-info">
                    <a class="wb-cart-name"
                       href="{{ path('product-details', {'slug': product.slug}) }}">
                        {{ product.name }}
                    </a>

                    <span class="wb-cart-unit">
                        {% if product.isPromotion %}
                            <s class="wb-cart-unit-old">{{ product.price|format_currency('XOF') }}</s>
                        {% endif %}
                        {{ this.finalUnitPrice|format_currency('XOF') }} l'unité
                    </span>

                    <button type="button" class="wb-cart-remove"
                            data-action="live#action"
                            data-live-action-param="removeItem"
                            aria-label="Retirer {{ product.name }} du panier">
                        <i class="fas fa-trash-alt"></i> Retirer
                    </button>
                </div>
            </div>
        </td>

        <td class="wb-cart-cell wb-cart-cell--qty" data-label="Quantité">
            <div class="wb-cart-qty">
                <button type="button" class="wb-cart-qty-btn"
                        data-action="live#action"
                        data-live-action-param="decreaseQuantity"
                        aria-label="Diminuer la quantité"
                        {% if quantity <= 1 %}disabled{% endif %}>−</button>

                <span class="wb-cart-qty-value"
                      aria-live="polite">{{ quantity }}</span>

                <button type="button" class="wb-cart-qty-btn"
                        data-action="live#action"
                        data-live-action-param="increaseQuantity"
                        aria-label="Augmenter la quantité">+</button>
            </div>
        </td>

        <td class="wb-cart-cell wb-cart-cell--total" data-label="Total">
            <span class="wb-cart-line-total">{{ this.lineTotal|format_currency('XOF') }}</span>
        </td>
    {% endif %}
</tr>
