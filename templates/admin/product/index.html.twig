{% extends 'base_admin.html.twig' %}

{% block title %}Produits{% endblock %}
{% block page_title %}Produits{% endblock %}

{% import 'admin/_macros.html.twig' as ui %}

{% block body %}

    {# ---------------- Barre de filtres (liste filtrable) ---------------- #}
    <form method="get" action="{{ path('admin_product_index') }}" class="admin-filters">
        <div class="admin-filter-field" style="flex: 2 1 260px;">
            <label for="f-q">Recherche</label>
            <input class="form-control" type="search" id="f-q" name="q"
                   value="{{ filters.q }}" placeholder="Nom du produit…">
        </div>

        <div class="admin-filter-field">
            <label for="f-state">Visibilité</label>
            <select class="form-select" id="f-state" name="state">
                <option value="">— Tous —</option>
                <option value="actif" {{ filters.state == 'actif' ? 'selected' }}>Actif</option>
                <option value="inactif" {{ filters.state == 'inactif' ? 'selected' }}>Inactif</option>
            </select>
        </div>

        <div class="admin-filter-field">
            <label for="f-cat">Catégorie</label>
            <select class="form-select" id="f-cat" name="categorie">
                <option value="">— Toutes —</option>
                {% for category in categories %}
                    <option value="{{ category.id }}" {{ filters.categorie == category.id ? 'selected' }}>
                        {{ category.name }}
                    </option>
                {% endfor %}
            </select>
        </div>

        {% if boutiques is defined and boutiques|length > 0 %}
            <div class="admin-filter-field">
                <label for="f-shop">Boutique</label>
                <select class="form-select" id="f-shop" name="boutique">
                    <option value="">— Toutes —</option>
                    {% for shop in boutiques %}
                        <option value="{{ shop.id }}" {{ filters.boutique == shop.id ? 'selected' }}>
                            {{ shop.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>
        {% endif %}

        <div class="admin-filters-actions">
            <button type="submit" class="btn btn-admin">
                <i class="fas fa-filter"></i> Filtrer
            </button>
            <a href="{{ path('admin_product_index') }}" class="btn btn-admin btn-admin-light" title="Réinitialiser">
                <i class="fas fa-undo"></i>
            </a>
        </div>
    </form>

    <div class="admin-card">
        <div class="admin-card-header">
            <div>
                <h2 class="admin-card-title">Catalogue</h2>
                <p class="admin-card-sub mb-0">
                    {{ pagination.totalItemCount }} produit{{ pagination.totalItemCount > 1 ? 's' : '' }}
                    {% if admin_scope.isVendor %} · votre boutique uniquement{% endif %}
                </p>
            </div>
            <a href="{{ path('admin_product_new') }}" class="btn btn-admin btn-admin-accent">
                <i class="fas fa-plus"></i> Nouveau produit
            </a>
        </div>

        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                <tr>
                    <th>Produit</th>
                    {% if admin_scope.isSuperAdmin %}<th>Boutique</th>{% endif %}
                    <th>Catégories</th>
                    <th>Prix</th>
                    <th>Stock</th>
                    <th>Statut</th>
                    <th class="text-end">Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for product in pagination %}
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                {% if product.illustration %}
                                    <img class="admin-thumb"
                                         src="{{ asset('images/products/' ~ product.illustration) }}"
                                         alt="{{ product.name }}">
                                {% else %}
                                    <span class="admin-thumb-placeholder"><i class="fas fa-image"></i></span>
                                {% endif %}
                                <span>
                                    <a class="admin-cell-main" href="{{ path('admin_product_show', {id: product.id}) }}">
                                        {{ product.name }}
                                    </a>
                                    <span class="admin-cell-sub">/{{ product.slug }}</span>
                                </span>
                            </div>
                        </td>

                        {% if admin_scope.isSuperAdmin %}
                            <td>{{ product.shop ? product.shop.name : '—' }}</td>
                        {% endif %}

                        <td>
                            {% if product.categories|length > 0 %}
                                {% for category in product.categories|slice(0, 2) %}
                                    <span class="admin-badge-soft">{{ category.name }}</span>
                                {% endfor %}
                                {% if product.categories|length > 2 %}
                                    <span class="admin-cell-sub">+{{ product.categories|length - 2 }}</span>
                                {% endif %}
                            {% else %}
                                —
                            {% endif %}
                        </td>

                        <td>
                            {% if product.isPromotion and product.offPercent %}
                                <span class="admin-amount-promo">{{ product.promoPrice|fcfa }}</span>
                                <span class="admin-cell-sub"><s>{{ product.price|fcfa }}</s> · -{{ product.offPercent }}%</span>
                            {% else %}
                                {{ product.price|fcfa }}
                            {% endif %}
                        </td>

                        <td>
                            {% if product.stock is null %}
                                <span class="admin-cell-sub">non géré</span>
                            {% elseif product.stock == 0 %}
                                <span class="admin-tag admin-tag-danger">Rupture</span>
                            {% else %}
                                {{ product.stock }}
                            {% endif %}
                        </td>

                        <td>{{ ui.tag(product.state) }}</td>

                        <td>
                            <div class="admin-row-actions">
                                {{ ui.action(path('admin_product_show', {id: product.id}), 'fa-eye', 'Voir') }}
                                {{ ui.action(path('admin_product_edit', {id: product.id}), 'fa-pen', 'Modifier') }}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    {{ ui.empty(7, 'Aucun produit', 'Créez votre premier produit ou modifiez vos filtres.') }}
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% include 'admin/_pagination.html.twig' %}
    </div>

{% endblock %}
