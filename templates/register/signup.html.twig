{% extends 'base.html.twig' %}

{% block title %}Créer un compte{% endblock %}

{% block stylesheets %}
    {% include 'auth/_styles.html.twig' %}
{% endblock %}

{% block body %}
    <!--------------- register-section --------------->
    <section class="auth-page">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <div class="auth-card">

                        <div class="auth-head">
                            <h1 class="auth-title">Créez votre compte</h1>
                            <p class="auth-sub">Rejoignez-nous pour une expérience shopping unique</p>
                        </div>

                        {# form_start / form_end encadrent le contenu de la carte
                           (avant : ils entouraient toute la section). #}
                        {{ form_start(form, {'attr': {'class': 'auth-form'}}) }}
                            <div class="auth-fields">
                                {# Prénom et Nom #}
                                <div class="auth-fields__pair">
                                    <div class="auth-field">
                                        <div class="form-floating">
                                            {{ form_widget(form.firstName, {'attr': {'placeholder': 'Prénom', 'autocomplete': 'given-name'}}) }}
                                            <label for="{{ form.firstName.vars.id }}">Prénom</label>
                                        </div>
                                    </div>
                                    <div class="auth-field">
                                        <div class="form-floating">
                                            {{ form_widget(form.lastName, {'attr': {'placeholder': 'Nom', 'autocomplete': 'family-name'}}) }}
                                            <label for="{{ form.lastName.vars.id }}">Nom</label>
                                        </div>
                                    </div>
                                </div>

                                {# Email #}
                                <div class="auth-field">
                                    <div class="form-floating">
                                        {{ form_widget(form.email, {'attr': {'placeholder': 'Adresse e-mail', 'autocomplete': 'email'}}) }}
                                        <label for="{{ form.email.vars.id }}">Adresse e-mail</label>
                                    </div>
                                </div>

                                {# Téléphone (champ libre, non transmis au serveur) #}
                                <div class="auth-field">
                                    <div class="form-floating">
                                        <input type="tel" id="phone" name="phone" class="form-control"
                                               placeholder="Numéro portable" autocomplete="tel" inputmode="tel">
                                        <label for="phone">Numéro portable</label>
                                    </div>
                                </div>

                                {# Mot de passe #}
                                <div class="auth-field">
                                    <div class="form-floating">
                                        {{ form_widget(form.password.first, {'attr': {'placeholder': 'Mot de passe', 'autocomplete': 'new-password'}}) }}
                                        <label for="{{ form.password.first.vars.id }}">Mot de passe</label>
                                    </div>
                                    {{ form_errors(form.password.first) }}
                                </div>

                                {# Confirmation du mot de passe #}
                                <div class="auth-field">
                                    <div class="form-floating">
                                        {{ form_widget(form.password.second, {'attr': {'placeholder': 'Confirmation', 'autocomplete': 'new-password'}}) }}
                                        <label for="{{ form.password.second.vars.id }}">Confirmez le mot de passe</label>
                                    </div>
                                    {{ form_errors(form.password.second) }}
                                </div>
                            </div>

                            {# Bouton et lien #}
                            <div class="auth-actions">
                                {{ form_widget(form.save, {
                                    'label': 'Créer mon compte',
                                    'attr': {'class': 'auth-btn'}
                                }) }}

                                <p class="auth-note">
                                    Déjà un compte ?
                                    <a href="{{ path('app_login') }}" class="auth-link">Se connecter</a>
                                </p>
                            </div>
                        {{ form_end(form) }}

                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--------------- register-section-end --------------->
{% endblock %}
