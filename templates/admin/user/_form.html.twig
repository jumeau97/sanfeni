{% import 'admin/_macros.html.twig' as ui %}

{{ form_start(form, {'attr': {'class': 'admin-form', 'novalidate': 'novalidate'}}) }}

{% if not form.vars.valid %}
    <div class="admin-flash admin-flash-error">
        <i class="fas fa-times-circle mt-1"></i>
        <div><strong>Le formulaire contient des erreurs.</strong>{{ form_errors(form) }}</div>
    </div>
{% endif %}

<fieldset class="admin-form-fieldset">
    <legend>Identité</legend>
    <div class="row g-3">
        <div class="col-md-6">{{ form_row(form.firstName) }}</div>
        <div class="col-md-6">{{ form_row(form.lastName) }}</div>
        <div class="col-12">{{ form_row(form.email) }}</div>
    </div>
</fieldset>

<fieldset class="admin-form-fieldset">
    <legend>Accès</legend>
    <div class="row g-3">
        {% if form.roles is defined %}
            <div class="col-12">
                {{ form_row(form.roles) }}
                <div class="admin-form-help">
                    <i class="fas fa-shield-alt me-1"></i>
                    <strong>Administrateur</strong> et <strong>Manager</strong> voient toute la marketplace.
                    Les autres comptes (vendeurs) ne voient que les données de leur boutique.
                </div>
            </div>
        {% endif %}

        {% if form.shop is defined %}
            <div class="col-md-6">{{ form_row(form.shop) }}</div>
        {% endif %}

        <div class="col-md-6">{{ form_row(form.plainPassword) }}</div>
    </div>
</fieldset>

<div class="admin-form-actions">
    <button type="submit" class="btn btn-admin btn-admin-accent">
        <i class="fas fa-check"></i> {{ submit_label|default('Enregistrer') }}
    </button>
    {{ ui.back(back_url|default(path('admin_user_index')), 'Annuler') }}
</div>

{{ form_widget(form._token) }}
{{ form_end(form, {'render_rest': false}) }}
