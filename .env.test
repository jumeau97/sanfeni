# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# .env.local est délibérément ignoré par Symfony en environnement "test"
# (voir Dotenv::loadEnv) : les variables doivent donc être définies ici.
# Valeurs de test : aucun e-mail réel n'est envoyé, aucun secret de production.

###> doctrine/doctrine-bundle ###
# La config ajoute le suffixe "_test" (config/packages/doctrine.yaml) :
# la base réellement utilisée est donc "db_vente_test".
DATABASE_URL="mysql://root:root@127.0.0.1:8889/db_vente?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Transport nul : les tests ne doivent jamais émettre de vrai e-mail.
MAILER_DSN=null://null
###< symfony/mailer ###

###> lexik/jwt-authentication-bundle ###
JWT_PASSPHRASE=test-passphrase
STRIPE_SECRET_KEY=sk_test_dummy
###< lexik/jwt-authentication-bundle ###
