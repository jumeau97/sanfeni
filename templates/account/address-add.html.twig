{% extends 'base.html.twig' %}

{% block title %}Ajouter une adresse{% endblock %}

{% block stylesheets %}
    {% include 'account/_account_styles.html.twig' %}
    <style>
        /* Page /account/add-address — formulaire unique centré.
           La largeur, le centrage et le style des champs viennent de
           account/_account_styles.html.twig (.account-column, .form-control).
           Le correctif responsive n'est plus nécessaire : la grille est
           fluide et .account-column n'a plus de largeur fixe. */

        .account-page .acc-form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1.6rem 2rem;
        }

        .account-page .acc-form-grid .mb-3 {
            margin-bottom: 0;
        }

        .account-page .acc-field--full {
            grid-column: 1 / -1;
        }

        @media (max-width: 576px) {
            .account-page .acc-form-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <section class="user-profile account-page">
        <div class="container">
            <div class="account-column">

                <header class="account-head">
                    <div>
                        <h1>Ajouter une adresse</h1>
                        <a href="{{ path('app_account_address') }}" class="account-back">
                            <i class="fas fa-arrow-left"></i> Retour à mes adresses
                        </a>
                    </div>
                </header>

                <div class="acc-card">
                    {{ form_start(form) }}
                        <div class="acc-form-grid">
                            <div>{{ form_row(form.firstName, {'label': 'Prénom'}) }}</div>
                            <div>{{ form_row(form.lastName, {'label': 'Nom'}) }}</div>

                            <div class="acc-field--full">{{ form_row(form.phone, {'label': 'Téléphone'}) }}</div>
                            <div class="acc-field--full">{{ form_row(form.company, {'label': 'Société (optionnel)'}) }}</div>
                            <div class="acc-field--full">{{ form_row(form.address, {'label': 'Adresse'}) }}</div>

                            <div>{{ form_row(form.city, {'label': 'Ville'}) }}</div>
                            <div>{{ form_row(form.country, {'label': 'Pays'}) }}</div>
                        </div>

                        <div class="form-actions">
                            <a href="{{ path('app_account_address') }}" class="acc-btn acc-btn--outline">Annuler</a>
                            <button type="submit" class="acc-btn acc-btn--primary">Ajouter l'adresse</button>
                        </div>
                    {{ form_end(form) }}
                </div>

            </div>
        </div>
    </section>
{% endblock %}
