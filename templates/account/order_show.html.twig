{% extends 'base.html.twig' %}

{% block title %}Ma commande{% endblock %}

{% block stylesheets %}
    <style>


        /* Typographie & Caps */
        .small-caps {
            font-size: 1.2rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            font-weight: 700;
        }

        /* Badges Soft */
        .bg-soft-primary {
            background-color: #FFF;
            color: var(--wb-purple);
        }

        /* Bordures Desktop */
        @media (min-width: 768px) {
            .border-end-md {
                border-right: 1px solid #f0f0f0 !important;
            }
        }

        /* Table Style */
        .table thead {
            border-bottom: 1px solid #eee;
        }

        .table tbody tr {
            transition: background 0.2s ease;
        }

        /* Polices augmentées */
        .fs-2 {
            font-size: 2.2rem !important;
        }

        .fs-3 {
            font-size: 1.8rem !important;
        }

        .fs-4 {
            font-size: 1.6rem !important;
        }

        .fs-5 {
            font-size: 1.2rem !important;
        }

        .fs-6 {
            font-size: 1.1rem !important;
        }

        /* Le récapitulatif reste collant sous le header épinglé. */
        .wb-sticky-aside {
            top: 20px;
        }

        /* Responsive Mobile */
        @media (max-width: 576px) {
            .fs-2 {
                font-size: 1.6rem !important;
            }

            .table-responsive {
                border: 1px solid #eee;
                border-radius: 12px;
            }
        }
    </style>
{% endblock %}

{% block body %}

    <!---------------user-profile-section---------------->
    <!--------------- user-profile-section-end --------------->


    <section class="order-details py-5 bg-light">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="fw-bold mb-1 fs-2">Détails de la commande</h1>
                    <a href="{{ path('account_order') }}" class="text-muted text-decoration-none fw-bold">
                        <i class="bi bi-arrow-left me-1"></i> Retour à mes commandes
                    </a>
                </div>
                <span class="badge bg-soft-primary text-primary px-4 py-2 rounded-pill fs-4 fw-bold">
                {{ order.reference }}
            </span>
            </div>

            <div class="row g-4">
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <div class="row gy-3">
                            <div class="col-md-4 border-end-md text-center text-md-start">
                                <p class="text-muted small-caps mb-1">Passée le</p>
                                <h5 class="fw-bold mb-0 fs-4">{{ order.createdAt|date('d/m/Y') }}</h5>
                            </div>
                            <div class="col-md-4 border-end-md text-center text-md-start">
                                <p class="text-muted small-caps mb-1">Transporteur</p>
                                <h5 class="fw-bold mb-0 fs-4">{{ order.carriername }}</h5>
                            </div>
                            <div class="col-md-4 text-center text-md-start">
                                <p class="text-muted small-caps mb-1">Statut</p>
                                <h5 class="fw-bold mb-0 text-success fs-4"><i class="bi bi-check-circle-fill me-1"></i>
                                    {{ order.state }}
                                </h5>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                <tr>
                                    <th class="ps-4 py-3 text-muted small-caps border-0">Produit</th>
                                    <th class="text-center py-3 text-muted small-caps border-0">Quantité</th>
                                    <th class="text-end py-3 text-muted small-caps border-0">Prix Unitaire</th>
                                    <th class="text-end pe-4 py-3 text-muted small-caps border-0">Total</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for product in order.orderDetails %}
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <h6 class="fw-bold mb-0 fs-4">{{ product.product }}</h6>
                                        </td>
                                        <td class="text-center fw-bold fs-4">x {{ product.quantity }}</td>
                                        <td class="text-end fw-medium fs-4 text-muted">{{ (product.price)|number_format(0,',','.') }}
                                            F
                                        </td>
                                        <td class="text-end pe-4 fw-bold fs-4 text-dark">{{ (product.total)|number_format(0,',','.') }}
                                            F
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top wb-sticky-aside">
                        <h5 class="fw-bold mb-4 fs-4">Résumé financier</h5>

                        <div class="d-flex justify-content-between mb-3 fs-4">
                            <span class="text-muted">Sous-total</span>
                            <span class="fw-bold">{{ (order.getTotal)|number_format(0,',','.') }} F cfa</span>
                        </div>

                        <div class="d-flex justify-content-between mb-3 fs-4">
                            <span class="text-muted">Livraison</span>
                            <span class="fw-bold">{{ (order.carrierprice)|number_format(0,',','.') }} F cfa</span>
                        </div>

                        <hr class="my-4 border-light">

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fs-4 fw-bold">TOTAL</span>
                            <span class="fs-3 fw-bold text-primary">
                            {{ ((order.carrierPrice + order.getTotal))|number_format(0,',','.') }} <small>F</small>
                        </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
