{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block stylesheets %}
    {% include 'auth/_styles.html.twig' %}
{% endblock %}

{% block body %}
    <!--------------- login-section --------------->
    <section class="auth-page">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-7 col-lg-5">
                    <div class="auth-card">

                        <div class="auth-head">
                            <h1 class="auth-title">Se connecter</h1>
                            <p class="auth-sub">Bon retour parmi nous !</p>
                        </div>

                        {% if error %}
                            <div class="auth-alert" role="alert">
                                {{ error.messageKey|trans(error.messageData, 'security') }}
                            </div>
                        {% endif %}

                        {# UN seul <form> : la page en contenait deux imbriqués
                           (invalide — le navigateur ignorait le 2ᵉ balisage
                           de départ et le </form> final de trop). #}
                        <form method="post" class="auth-form">
                            <div class="auth-fields">
                                {# Email #}
                                <div class="auth-field">
                                    <div class="form-floating">
                                        <input type="email" value="{{ last_username }}" name="_username" id="username"
                                               class="form-control" placeholder="Adresse e-mail"
                                               autocomplete="email" required autofocus>
                                        <label for="username">Adresse e-mail</label>
                                    </div>
                                </div>

                                {# Mot de passe #}
                                <div class="auth-field">
                                    <div class="form-floating">
                                        <input type="password" name="_password" id="password"
                                               class="form-control" placeholder="Mot de passe"
                                               autocomplete="current-password" required>
                                        <label for="password">Mot de passe</label>
                                    </div>
                                </div>
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            {# Options #}
                            <div class="auth-options">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="_remember_me" id="remember_me">
                                    <label class="form-check-label" for="remember_me">
                                        Se rappeler de moi
                                    </label>
                                </div>
                                <a href="#" class="auth-link">Mot de passe oublié ?</a>
                            </div>

                            <button class="auth-btn" type="submit">Se connecter</button>

                            <p class="auth-note">
                                Vous n'avez pas de compte ?
                                <a href="{{ path('register_customer') }}" class="auth-link">Créer un compte</a>
                            </p>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--------------- login-section-end --------------->
{% endblock %}
