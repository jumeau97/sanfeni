{% extends 'base.html.twig' %}

{% block title %}Nos produits{% endblock %}

{% block stylesheets %}
    <style>
        /* ============================================================
           PAGE D'ACCUEIL — codes visuels e-commerce façon Wildberries

           Identité chromatique du projet CONSERVÉE (aucun passage au
           violet/pourpre de Wildberries) :
             · #082C6A  bleu nuit  → couleur principale : titres, liens,
                                     structure, survols
             · #FFA500  orange    → accent : bouton d'action, badges promo
             · #ff3b30  rouge     → prix (remise)

           ⚠️  CONVENTION DE TAILLE DU PROJET
               public/css/style.css déclare `html { font-size: 10px; }`
               → 1rem = 10px (et NON 16px).
               Écrire `.85rem` donne donc 8,5 px, pas 13,6 px.
               Toutes les valeurs ci-dessous sont exprimées dans cette
               convention : 1.5rem = 15px, 2rem = 20px, etc.

           Parti pris : épuré. Fond clair, cartes blanches, séparation
           par l'espace plutôt que par les bordures épaisses.
           ============================================================ */
        .wb-home {
            --wb-navy: #082C6A;
            --wb-orange: #FFA500;
            --wb-red: #ff3b30;
            --wb-ink: #1b1d21;
            --wb-muted: #767b83;
            --wb-line: #e8eaee;
            --wb-surface: #ffffff;
            --wb-soft: #f5f6f8;
            --wb-radius: 14px;

            /* Garde-fou : le document racine est à 10px, donc un texte
               sans font-size explicite tomberait à 10px. On pose une
               base lisible (15px) sur toute la section. */
            font-size: 1.5rem;

            /* ------------------------------------------------------
               Conteneur : marges latérales bornées et aérées.
               Le contenu ne doit plus toucher les bords du viewport.
               clamp() = ~14px sur mobile, ~40px sur grand écran.
               Le min (14px) reste ≥ à la demi-gouttière Bootstrap
               (12px) : la grille s'aligne donc exactement au bord
               du conteneur.
               ------------------------------------------------------ */
            max-width: 1440px;
            margin-inline: auto;
            padding-inline: clamp(14px, 3vw, 40px);
            padding-bottom: 8px;
        }

        /* ===========================================================
           1. RACCOURCIS DE CATÉGORIES
           =========================================================== */
        .wb-cats {
            margin-top: 24px;
        }

        .wb-cats-track {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .wb-cat {
            flex: 0 0 auto;
            padding: 9px 18px;
            border: 1px solid var(--wb-line);
            border-radius: 999px;
            background: var(--wb-surface);
            color: var(--wb-ink);
            font-size: 1.5rem;          /* hiérarchie : niveau 4 — 15px */
            font-weight: 500;
            line-height: 1.4;
            text-decoration: none;
            white-space: nowrap;
            transition: background-color .16s ease, border-color .16s ease,
                        color .16s ease, transform .16s ease,
                        box-shadow .16s ease;
        }

        .wb-cat:hover,
        .wb-cat:focus-visible {
            background: var(--wb-navy);
            border-color: var(--wb-navy);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(8, 44, 106, .18);
        }

        /* ===========================================================
           2. BANDEAU SERVICES
           =========================================================== */
        .wb-usp {
            margin-top: 24px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            background: var(--wb-surface);
            border: 1px solid var(--wb-line);
            border-radius: var(--wb-radius);
            padding: 18px 22px;
        }

        .wb-usp-item {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
        }

        .wb-usp-icon {
            flex: 0 0 auto;
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: var(--wb-soft);
            color: var(--wb-navy);
            display: grid;
            place-items: center;
            font-size: 1.8rem;          /* icône — 18px */
        }

        .wb-usp-item strong {
            display: block;
            font-size: 1.5rem;          /* hiérarchie : niveau 3 — 15px */
            font-weight: 650;
            line-height: 1.35;
            color: var(--wb-ink);
        }

        .wb-usp-item span {
            display: block;
            font-size: 1.35rem;         /* hiérarchie : niveau 5 — 13,5px */
            line-height: 1.4;
            color: var(--wb-muted);
        }

        /* ===========================================================
           3. EN-TÊTE DE SECTION
           =========================================================== */
        .wb-products {
            margin-top: 38px;
            padding-bottom: 46px;
        }

        .wb-head {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 8px 20px;
            margin-bottom: 22px;
            padding-bottom: 14px;
            border-bottom: 1px solid var(--wb-line);
        }

        .wb-head h1 {
            position: relative;
            margin: 0;
            padding-top: 13px;
            font-size: clamp(2rem, 2.5vw, 2.3rem);  /* hiérarchie : niveau 1 — 20→23px */
            font-weight: 800;
            letter-spacing: -.02em;
            line-height: 1.25;
            color: var(--wb-ink);
        }

        /* Filet de marque : ancre la couleur principale sur chaque titre */
        .wb-head h1::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 38px;
            height: 4px;
            border-radius: 3px;
            background: var(--wb-navy);
        }

        .wb-head-count {
            font-size: 1.35rem;         /* hiérarchie : niveau 5 — 13,5px */
            color: var(--wb-muted);
            font-weight: 500;
            margin-inline-start: 8px;
        }

        .wb-all {
            font-size: 1.5rem;          /* hiérarchie : niveau 4 — 15px */
            font-weight: 650;
            color: var(--wb-navy);
            text-decoration: none;
            white-space: nowrap;
        }

        .wb-all:hover {
            text-decoration: underline;
            text-underline-offset: 3px;
        }

        /* Gouttières : g-3/g-md-4 sur la row + mb-4 sur la colonne
           se cumulaient (double espacement vertical). */
        .wb-products .row > [class*="col-"] {
            margin-bottom: 0;
        }

        /* ===========================================================
           4. CARTE PRODUIT — style marketplace
           Claire, légère, avec effet au survol.
           =========================================================== */
        .wb-products .product-card {
            background: var(--wb-surface);
            border: 1px solid var(--wb-line);
            border-radius: var(--wb-radius);
            padding: 7px;
            overflow: hidden;
            transition: transform .2s ease, box-shadow .2s ease,
                        border-color .2s ease;
        }

        .wb-products .product-card:hover {
            transform: translateY(-4px);
            border-color: #d5dae2;
            box-shadow: 0 14px 30px rgba(8, 44, 106, .12);
        }

        /* Visuel : sans ombre, format CARRÉ, l'image REMPLIT le rectangle.

           object-fit: cover + object-position: center : la photo recadre
           au centre et couvre tout le cadre, sans déformation (ratio source
           préservé) et sans bandes vides — les ratios sources sont très
           hétérogènes (200×120 → 1440×173, 900×1200, 1080×1080), un
           contain laissait de grandes zones grises autour du produit.
           Le padding est supprimé : le visuel touche les bords du cadre. */
        .wb-products .img-container {
            box-shadow: none !important;
            border-radius: 9px;
            background: #f6f7f9;
        }

        .wb-products .product-img {
            aspect-ratio: 1 / 1;
            object-fit: cover;
            object-position: center;
            padding: 0;
            background: transparent;
            transition: transform .35s ease;
        }

        .wb-products .product-card:hover .product-img {
            transform: scale(1.04);
        }

        /* ---------- Badge de réduction : bien visible ---------- */
        .wb-products .discount-badge {
            top: 7px;
            left: 7px;
            bottom: auto;
            background: var(--wb-orange);
            color: #1b1d21;
            font-size: 1.25rem;         /* 12,5px */
            font-weight: 800;
            line-height: 1.35;
            letter-spacing: -.01em;
            padding: 5px 10px;
            border-radius: 9px;
            box-shadow: 0 2px 7px rgba(0, 0, 0, .18);
        }

        /* ---------- Étiquette de prix : percutante ---------- */
        .wb-products .price-current {
            color: var(--wb-red);
            font-size: 2rem;            /* hiérarchie : niveau 2 — 20px */
            font-weight: 800;
            letter-spacing: -.02em;
            line-height: 1.15;
        }

        .wb-products .price-old {
            color: var(--wb-muted);
            font-size: 1.35rem;         /* 13,5px */
            font-weight: 500;
        }

        /* Prix sans remise : neutre — le rouge est réservé aux promos */
        .wb-products .price-current--plain {
            color: var(--wb-ink);
        }

        /* Économie réalisée : pastille bleu nuit, lisible d'un coup d'œil */
        .wb-products .wb-save {
            display: inline-block;
            margin-top: 7px;
            padding: 3px 8px;
            border-radius: 6px;
            background: rgba(8, 44, 106, .07);
            color: var(--wb-navy);
            font-size: 1.25rem;         /* 12,5px */
            font-weight: 700;
            letter-spacing: -.01em;
        }

        /* ---------- Intitulé ----------
           height doit rester = line-height × 2 lignes, sinon le second
           titre est rogné (2 × 15px × 1.4 = 42px = 2.8em). */
        .wb-products .product-title {
            font-size: 1.5rem;          /* hiérarchie : niveau 4 — 15px */
            font-weight: 500;
            line-height: 1.4;
            margin-top: 6px;
            color: var(--wb-ink);
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            height: 2.8em;
            min-height: 2.8em;
        }

        .wb-products .product-title:hover {
            color: var(--wb-navy);
        }

        /* ---------- Bouton d'action ---------- */
        .wb-products .btn-wb {
            font-size: 1.45rem;         /* hiérarchie : niveau 4 — 14,5px */
            font-weight: 650;
            padding: 10px 12px;
            border-radius: 9px;
            box-shadow: none;
        }

        .wb-products .btn-wb:hover {
            box-shadow: none;
        }

        .wb-products .btn-wb .btn-label-long {
            display: none;
        }

        /* ===========================================================
           5. ÉTAT VIDE
           =========================================================== */
        .wb-empty {
            width: 100%;
            text-align: center;
            padding: 54px 20px;
            background: var(--wb-surface);
            border: 1px dashed var(--wb-line);
            border-radius: var(--wb-radius);
        }

        .wb-empty i {
            font-size: 3.4rem;          /* 34px */
            color: #cfd4da;
        }

        .wb-empty h4 {
            margin: 16px 0 8px;
            font-size: 1.7rem;          /* 17px */
            font-weight: 700;
            color: var(--wb-ink);
        }

        .wb-empty p {
            margin: 0;
            color: var(--wb-muted);
            font-size: 1.45rem;         /* 14,5px */
        }

        /* ===========================================================
           6. RESPONSIVE
           =========================================================== */
        @media (max-width: 767px) {
            .wb-usp {
                grid-template-columns: 1fr;
                gap: 14px;
                padding: 16px 18px;
            }

            .wb-products {
                margin-top: 30px;
            }

            .wb-products .price-current {
                font-size: 1.8rem;      /* 18px sur mobile */
            }

            .wb-head h1 {
                font-size: 1.9rem;      /* 19px sur mobile */
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="wb-home">

        {# ---------- 1. Raccourcis de catégories ---------- #}
        {% if categories is defined and categories is not empty %}
            <nav class="wb-cats" aria-label="Catégories">
                <div class="wb-cats-track">
                    {% for cat in categories %}
                        <a class="wb-cat" href="{{ path('app_home', {'slug': cat.name}) }}">{{ cat.name }}</a>
                    {% endfor %}
                </div>
            </nav>
        {% endif %}

        {# ---------- 2. Services ---------- #}
        <section class="wb-usp" aria-label="Nos services">
            <div class="wb-usp-item">
                <div class="wb-usp-icon"><i class="fas fa-truck"></i></div>
                <div>
                    <strong>Livraison à domicile</strong>
                    <span>Partout au Mali</span>
                </div>
            </div>
            <div class="wb-usp-item">
                <div class="wb-usp-icon"><i class="fas fa-lock"></i></div>
                <div>
                    <strong>Paiement sécurisé</strong>
                    <span>Transactions protégées</span>
                </div>
            </div>
            <div class="wb-usp-item">
                <div class="wb-usp-icon"><i class="fab fa-whatsapp"></i></div>
                <div>
                    <strong>Besoin d'aide ?</strong>
                    <span>Réponse rapide sur WhatsApp</span>
                </div>
            </div>
        </section>

        {# ---------- 3. Grille produits ---------- #}
        <section class="wb-products">
            <div class="wb-head">
                <h1>
                    Notre sélection
                    <span class="wb-head-count">{{ products.totalItemCount }} article{{ products.totalItemCount > 1 ? 's' : '' }}</span>
                </h1>
                {% if products.totalPage > 1 %}
                    <a class="wb-all" href="{{ path('app_home', {'page': products.currentPageNumber + 1}) }}">
                        Voir la suite &rarr;
                    </a>
                {% endif %}
            </div>

            <div class="row g-3 g-md-4">
                {% for product in products.items %}
                    {{ component('ProductItem', {
                        product: product
                    }) }}
                {% else %}
                    <div class="wb-empty">
                        <i class="fas fa-search"></i>
                        <h4>Aucun produit trouvé</h4>
                        <p>Désolé, nous n'avons trouvé aucun article correspondant à votre sélection.</p>
                    </div>
                {% endfor %}
            </div>
        </section>

    </div>
{% endblock %}
