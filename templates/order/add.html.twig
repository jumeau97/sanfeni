{% extends 'base.html.twig' %}

{% block javascripts %}
    <script src="https://js.stripe.com/v3/"></script>
{% endblock %}

{% block stylesheets %}
    {% include 'order/_checkout_styles.html.twig' %}
    <style>
        /* Le montant du total est déjà porté par la carte
           (.wb-grand) : sur desktop la barre ne garde que le bouton. */
        .wb-checkout .wb-actionbar__total {
            display: none;
        }
    </style>
{% endblock %}

{% block title %}Confirmation - Panier{% endblock %}

{% block body %}
    <!--------------- checkout-section---------------->
    <section class="checkout-recap wb-checkout">
        <div class="container">
            <header class="wb-checkout-head">
                <h1 class="wb-checkout-title">Vérification de votre commande</h1>
                <p class="wb-checkout-sub">Récapitulatif puis paiement — dernière étape.</p>
            </header>

            <div class="row g-4">
                <div class="col-lg-7">
                    {# ---------------- Étape 1 : adresse ---------------- #}
                    <div class="wb-panel mb-4">
                        <div class="wb-panel-head">
                            <span class="wb-badge">1</span>
                            <h5 class="wb-panel-title">Adresse de livraison</h5>
                            <span class="wb-badge wb-badge--ico"><i class="fas fa-map-marker-alt"></i></span>
                        </div>
                        <div class="wb-panel-body">
                            <div class="wb-address">
                                <span class="wb-address__ico"><i class="fas fa-home"></i></span>
                                <div class="wb-address__body">
                                    {{ delivery|raw }}
                                </div>
                            </div>
                        </div>
                    </div>

                    {# ---------------- Étape 2 : transporteur ---------------- #}
                    <div class="wb-panel">
                        <div class="wb-panel-head">
                            <span class="wb-badge">2</span>
                            <h5 class="wb-panel-title">Mode d'expédition</h5>
                            <span class="wb-badge wb-badge--ico"><i class="fas fa-truck"></i></span>
                        </div>
                        <div class="wb-panel-body">
                            <div class="wb-carrier">
                                <div>
                                    <p class="wb-carrier__name">{{ carrier.name }}</p>
                                    <p class="wb-carrier__desc">{{ carrier.description }}</p>
                                </div>
                                <span class="wb-carrier__price">{{ carrier.price|format_currency('XOF') }}</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="sticky-top wb-sticky-aside">
                        <div class="wb-panel">
                            <div class="wb-panel-head">
                                <span class="wb-badge wb-badge--ico"><i class="fas fa-receipt"></i></span>
                                <h4 class="wb-panel-title">Récapitulatif</h4>
                                <span class="wb-chip">
                                    {{ cart|length }} article{{ cart|length > 1 ? 's' : '' }}
                                </span>
                            </div>
                            <div class="wb-panel-body">

                                <ul class="wb-recap-list">
                                    {% set total = 0 %}
                                    {% for product in cart %}
                                        {% if product.product.offPercent is defined and product.product.offPercent > 0 %}
                                            {% set unitPrice = (product.product.price ) * (1 - (product.product.offPercent / 100)) %}
                                        {% else %}
                                            {% set unitPrice = (product.product.price) %}
                                        {% endif %}
                                        {% set rowTotal = unitPrice * product.quantity %}
                                        {% set total = total + rowTotal %}

                                        <li class="wb-recap-row">
                                            <div class="wb-recap-info">
                                                <span class="wb-recap-name">{{ product.product.name }}</span>
                                                <span class="wb-recap-qty">Quantité : {{ product.quantity }}</span>
                                            </div>
                                            <span class="wb-recap-price">{{ rowTotal|format_currency('XOF') }}</span>
                                        </li>
                                    {% endfor %}
                                </ul>

                                <div class="wb-costs">
                                    <div class="wb-cost">
                                        <span>Sous-total produits</span>
                                        <strong>{{ total|format_currency('XOF') }}</strong>
                                    </div>
                                    <div class="wb-cost">
                                        <span>Frais de port</span>
                                        <strong>{{ carrier.price|format_currency('XOF') }}</strong>
                                    </div>
                                </div>

                                <div class="wb-grand">
                                    <span class="wb-grand__label">Total à payer</span>
                                    <strong class="wb-grand__value">{{ (total + carrier.price)|format_currency('XOF') }}</strong>
                                </div>

                                {{ form_start(form, {'action': path('stripe_create_session', {'reference':reference}),'attr': { 'data-turbo': 'false' }}) }}
                                <p class="wb-eyebrow wb-pay-title">Moyen de paiement</p>
                                <div class="wb-options payment-methods">
                                    {% for label, value in field_choices(form.payMethod) %}
                                        {% set inputId = field_id(form.payMethod) ~ '_' ~ loop.index %}
                                        <label class="wb-option" for="{{ inputId }}">
                                            <input type="radio" class="form-check-input"
                                                   name="{{ field_name(form.payMethod) }}" id="{{ inputId }}"
                                                   value="{{ value }}" autocomplete="off" required>
                                            <span class="wb-option__text">
                                                <i class="fas {{ value == 'PAY_ON_DELIVERY' ? 'fa-truck' : 'fa-credit-card' }}"></i>{{ label }}
                                            </span>
                                        </label>
                                    {% endfor %}
                                </div>

                                {# .wb-actionbar : sur mobile, ce bloc devient la
                                   barre fixe en bas d'écran (total + Confirmer). #}
                                <div class="wb-actionbar">
                                    <span class="wb-actionbar__total wb-total">
                                        <span class="wb-total__label">Total</span>
                                        <strong class="wb-total__value">{{ (total + carrier.price)|format_currency('XOF') }}</strong>
                                    </span>

                                    <button type="submit" class="wb-cta wb-actionbar__btn">
                                        Confirmer <i class="fas fa-lock"></i>
                                    </button>
                                </div>
                                {{ form_end(form) }}

                                <p class="wb-note">
                                    <i class="fas fa-shield-alt"></i> Transaction sécurisée par Stripe
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--------------- checkout-section-end---------------->
{% endblock %}
