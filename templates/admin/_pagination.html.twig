{# Pagination serveur (KnpPaginator) stylée par admin.css (.admin-pagination) #}
{% if pagination is defined and pagination %}
    {% if pagination.pageCount > 1 %}
        <div class="admin-pagination">
            <span>
                {{ pagination.totalItemCount }} élément{{ pagination.totalItemCount > 1 ? 's' : '' }}
                · page {{ pagination.currentPageNumber }} / {{ pagination.pageCount }}
            </span>
            {{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
        </div>
    {% else %}
        <div class="admin-pagination">
            <span>
                {{ pagination.totalItemCount }} élément{{ pagination.totalItemCount > 1 ? 's' : '' }}
            </span>
        </div>
    {% endif %}
{% endif %}
