{# Carte produit — la grille est portée par la ligne du template appelant
   (col-6 col-md-4 col-lg-2). Les classes stylées par le scope
   .wb-products de home/index.html.twig : grid clair, badge promo en haut
   à gauche, prix percutant, survol élévation. #}
<div {{ attributes }} class="col-6 col-md-4 col-lg-2">
    <div class="product-card h-100 position-relative">
        <a href="{{ path('product-details', {'slug' : product.slug} ) }}" data-turbo="false" class="text-decoration-none">
            <div class="img-container">
                <img src="{{ asset('images/products/' ~ product.illustration) }}"
                     class="product-img"
                     decoding="async"
                     alt="{{ product.name }}">

                {# Badge de réduction — visible en haut à gauche du visuel #}
                {% if product.isPromotion %}
                    <span class="discount-badge">-{{ product.offPercent }}%</span>
                {% endif %}

            </div>
        </a>

        <div class="card-body px-1 pt-2 pb-1">
            <div class="d-flex align-items-baseline flex-wrap">
                {% if product.isPromotion %}
                    <span class="price-current">
                        {{ ((product.price) * (1 - (product.offPercent / 100))) | format_currency('XOF') }}
                    </span>
                    <span class="price-old ms-1">
                        {{ (product.price)|format_currency('XOF') }}
                    </span>
                {% else %}
                    <span class="price-current price-current--plain">
                        {{ (product.price)|format_currency('XOF') }}
                    </span>
                {% endif %}
            </div>

            {# Économie réalisée : repère visuel fort, façon marketplace.
               (le prix est en unités CFA brutes, sans division par 100) #}
            {% if product.isPromotion %}
                <div class="wb-save">
                    Économisez {{ (product.price * product.offPercent / 100)|round|format_currency('XOF') }}
                </div>
            {% endif %}

            <a href="{{ path('product-details', {'slug' : product.slug} ) }}" class="product-title text-decoration-none">
                {{ product.name }}
            </a>

        </div>

        <div class="mt-auto pt-3">
            <button
                type="button"
                data-action="live#action"
                data-live-action-param="addToCart"
                class="btn btn-wb w-100 d-flex align-items-center justify-content-center">

                <i class="bi bi-cart3 me-2"></i>
                <span>Ajouter au panier</span>

                {# Optionnel : Un petit spinner qui apparaît pendant l'action Live #}
                <div class="spinner-border spinner-border-sm ms-2 d-none" data-live-active-class="d-inline-block" role="status"></div>
            </button>
        </div>
    </div>
</div>

